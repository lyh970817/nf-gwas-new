nextflow.enable.dsl=2

manifest {
    name                                  = 'nf-gwas'
    version                               = '1.0.9'
    description                           = 'A Nextflow GWAS pipeline.'
    mainScript                            = 'main.nf'
    nextflowVersion                       = '!>=22.10.4'
}

// Global default params
params {
    // =========================================================================
    // RESOURCE LIMITS
    // =========================================================================
    max_cpus                              = 10
    max_memory                            = 16.GB

    // =========================================================================
    // ANALYSIS TYPE SELECTION
    // =========================================================================
    run_grm_only                          = false
    run_association_analysis              = false
    run_heritability_estimation           = true
    run_genetic_correlation               = false

    // =========================================================================
    // GRM COMPUTATION OPTIONS
    // =========================================================================
    // GRM-only mode parameters
    grm_method                            = 'gcta'      // 'gcta', 'gcta_ldms', 'ldak'
    gcta_create_sparse_grm                = false       // Create sparse GRM for FastGWA
    gcta_sparse_cutoff                    = 0.05        // Sparse GRM cutoff value
    ldak_adjust_grm                       = false       // Create adjusted GRM for HE/PCGC

    // Pre-computed GRM inputs (for heritability/association analysis)
    use_precomputed_grm                   = false
    // GCTA GRM inputs:
    gcta_grm_prefix                       = null        // Path prefix to GCTA GRM files (e.g., /path/to/grm)
    gcta_mgrm_file                        = null        // Path to .mgrm file (for GREML-LDMS)
    gcta_sparse_grm_prefix                = null        // Path prefix to sparse GRM (for FastGWA)
    // LDAK GRM inputs:
    ldak_grm_prefix                       = null        // Path prefix to LDAK GRM (for REML, or HE/PCGC if not adjusted)
    ldak_adjusted_grm_prefix              = null        // Path prefix to adjusted GRM (for HE/PCGC, faster)
    // Note: The .keep file (unrelated individuals) is automatically loaded from {prefix}.keep

    // =========================================================================
    // COMMON INPUT PARAMETERS
    // =========================================================================
    pubDir                                = 'results'
    genotypes_prediction                  = null

    // Genotype input files for association/heritability analysis
    // Users can supply any combination - pipeline skips conversions when files are provided
    genotypes_association_vcf             = null    // VCF files, e.g., "data/chr*.vcf.gz"
    genotypes_association_plink1          = null    // PLINK1 files, e.g., "data/chr*.{bed,bim,fam}"
    genotypes_association_plink2          = null    // PLINK2 files, e.g., "data/chr*.{pgen,psam,pvar}"
    // Note: If PLINK1/PLINK2 files are supplied, they are used directly (no conversion)
    //       If only VCF is supplied, it is converted to both PLINK1 and PLINK2
    phenotypes_filename                   = null
    phenotypes_columns                    = null
    phenotypes_binary_trait               = false
    phenotypes_delete_missings            = false
    phenotypes_apply_rint                 = false
    covariates_filename                   = null
    covariates_columns                    = null
    covariates_cat_columns                = null

    // =========================================================================
    // ASSOCIATION ANALYSIS - REGENIE
    // =========================================================================
    association_method                    = 'regenie'
    regenie_skip_predictions              = false
    regenie_test                          = 'additive'
    regenie_force_step1                   = false
    regenie_ref_first                     = false
    regenie_low_mem                       = false
    regenie_firth                         = false
    regenie_firth_approx                  = false
    regenie_bsize_step1                   = 1000
    regenie_bsize_step2                   = 200
    regenie_min_mac                       = 1
    regenie_min_imputation_score          = 0.0
    regenie_condition_list                = null
    regenie_sample_file                   = null
    regenie_step1_optional                = null
    regenie_step2_optional                = null
    regenie_interaction                   = null
    regenie_interaction_snp               = null
    regenie_rare_mac                      = null
    regenie_no_condtl                     = false
    regenie_force_condtl                  = false
    regenie_gene_test                     = null
    regenie_gene_aaf                      = null
    regenie_gene_vc_max_aaf               = null
    regenie_gene_vc_mac_thr               = null
    regenie_gene_build_mask               = null
    regenie_write_bed_masks               = false
    regenie_gene_joint                    = null
    genotypes_prediction_chunks           = 0
    vcf_conversion_split_id               = false

    // MungeSumstats parameters (optional post-processing)
    run_munge_sumstats                    = false
    munge_genome_build                    = 'GRCh38'  // 'GRCh37' or 'GRCh38'
    munge_dbsnp_version                   = 0         // 0 = disabled (no SNPlocs package needed), or 144/155 etc.

    // =========================================================================
    // HERITABILITY ESTIMATION
    // =========================================================================
    heritability_method                   = 'ldak_qc'
    heritability_model                    = 'human_default'

    // GCTA parameters
    nparts_gcta                           = 15

    // LDAK HE parameters
    ldak_he_subset_prefix                 = null
    ldak_he_subset_number                 = null

    // LDAK PCGC parameters (binary traits)
    ldak_pcgc_prevalence                  = null

    // LDAK QC parameters
    batch_subset_prefix                   = null
    batch_subset_number                   = null

    // LDAK SumHer parameters
    ldak_sumher_tagfile                   = null
    ldak_sumher_check_sums                = false
    ldak_sumher_prevalence                = null
    ldak_sumher_cutoff                    = null
    ldak_sumher_summary_stats             = null
    ldak_sumher_liftover                  = false       // Enable liftover to convert genome build
    ldak_sumher_target_build              = 'GRCh37'    // Target genome build (GRCh37 for LDAK tagfiles)
    ldak_sumher_source_build              = 'auto'      // Source build: 'GRCh37', 'GRCh38', or 'auto'
    ldak_sumher_frq_filter                = 0.01        // MAF filter threshold (removes MAF < 0.01)

    // =========================================================================
    // GENETIC CORRELATION
    // =========================================================================
    genetic_correlation_method            = 'ldak_sumcors'

    // LDAK SumCors parameters
    ldak_sumcors_tagfile                  = null
    ldak_sumcors_check_sums               = false
    ldak_sumcors_prevalence1              = null
    ldak_sumcors_prevalence2              = null
    ldak_sumcors_summary_stats1           = null
    ldak_sumcors_summary_stats2           = null
    ldak_sumcors_liftover                 = false       // Enable liftover to convert genome build
    ldak_sumcors_target_build             = 'GRCh37'    // Target genome build (GRCh37 for LDAK tagfiles)
    ldak_sumcors_source_build             = 'auto'      // Source build: 'GRCh37', 'GRCh38', or 'auto'
    ldak_sumcors_frq_filter               = 0.01        // MAF filter threshold (removes MAF < 0.01)

    // GCTA Bivariate GREML parameters
    // genetic_correlation_method options:
    // - 'ldak_sumcors': Summary statistics-based (requires tagfile + summary stats)
    // - 'gcta_bivariate_greml': Individual-level, single GRM
    // - 'gcta_bivariate_greml_ldms': Individual-level, LD-stratified GRMs
    gcta_bivariate_phenotype1             = null
    gcta_bivariate_phenotype2             = null

    // =========================================================================
    // DEPRECATED PARAMETERS (backward compatibility)
    // =========================================================================
    genotypes_imputed                     = null    // Use genotypes_association_vcf instead
    genotypes_imputed_format              = null    // No longer needed
    genotypes_array                       = null    // Use genotypes_prediction instead
    genotypes_association                 = null    // Use genotypes_association_vcf instead
    genotypes_association_format          = null    // No longer needed - supply files directly
}

// Load base configuration
// includeConfig 'conf/base.config'

// Define profiles
profiles {
    debug {
        process.beforeScript = 'echo $HOSTNAME'
    }

    // =============================================================================
    // TEST PROFILES
    // =============================================================================
    // Base test profile (LDAK QC only - default)
    test {
        includeConfig 'conf/test.config'
    }

    // Association analysis test profiles
    test_association_regenie {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_association_regenie.config'
    }

    test_association_fastgwa {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_association_fastgwa.config'
    }

    // Heritability estimation test profiles
    test_heritability_gcta {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_gcta.config'
    }

    test_heritability_ldak_reml {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_reml.config'
    }

    test_heritability_ldak_he {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_he.config'
    }

    test_heritability_ldak_pcgc {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_pcgc.config'
    }

    test_heritability_ldak_qc {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_qc.config'
    }

    test_heritability_bolt {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_bolt.config'
    }

    // GRM-only computation test profiles
    test_grm_gcta {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_grm_gcta.config'
    }

    test_grm_gcta_ldms {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_grm_gcta_ldms.config'
    }

    test_grm_ldak {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_grm_ldak.config'
    }

    // Comprehensive test profile (all workflows)
    test_all {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_all_workflows.config'
    }

    // Input format test profiles (PLINK1/PLINK2 instead of VCF)
    test_plink1_input {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_plink1_input.config'
    }

    test_plink2_input {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_plink2_input.config'
    }

    test_plink_both {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_plink_both.config'
    }

    // =============================================================================
    // EXECUTION ENVIRONMENT PROFILES
    // =============================================================================
    singularity {
        process.container       = "${projectDir}/nf-gwas.sif"
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
        process.shell = ['/bin/bash', '-euo', 'pipefail']
    }

    docker {
        docker.enabled          = true
        singularity.enabled     = false
    }

    development {
        resume = true
    }

    slurm {
        process.executor = 'slurm'
    }

    slurm_with_scratch {
        process {
            executor = 'slurm'
            scratch  = true
        }
    }
}
