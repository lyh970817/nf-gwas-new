nextflow.enable.dsl=2

process.shell = ['/usr/bin/env', 'bash', '-euo', 'pipefail']

manifest {
    name                                  = 'nf-gwas'
    version                               = '1.0.9'
    description                           = 'A Nextflow GWAS pipeline.'
    mainScript                            = 'main.nf'
    nextflowVersion                       = '!>=22.10.4'
}

// Global default params
params {
    // =========================================================================
    // RESOURCE LIMITS
    // =========================================================================
    max_cpus                              = 10
    max_memory                            = 16.GB

    // =========================================================================
    // COMMON INPUT PARAMETERS
    // =========================================================================
    pubDir                                = 'results'
    genotyped_file                        = null
    genotypes_build                       = null
    imputed_genotyped_files_vcf           = null    // e.g. "data/chr*.vcf.gz"
    imputed_genotyped_files_plink1        = null    // e.g. "data/chr*.{bed,bim,fam}"
    imputed_genotyped_files_plink2        = null    // e.g. "data/chr*.{pgen,psam,pvar}"
    phenotypes_dir                        = null
    summary_stats_dir                     = "${projectDir}/summary_stats"
    grm_dir                               = "${projectDir}/grm"
    covariates_filename                   = null
    covariates_columns                    = null
    covariates_cat_columns                = null

    // Shared summary statistics columns (reused across MAGMA/LDSC workflows)
    sumstats_snp_col                      = 'Predictor'
    sumstats_a1_col                       = 'A1'
    sumstats_a2_col                       = 'A2'
    sumstats_p_col                        = 'P'
    sumstats_log10p_col                   = null
    sumstats_n_col                        = 'n'
    sumstats_n                            = null
    ldsc_munge_signed_sumstats            = null

    // =========================================================================
    // GWAS ASSOCIATION WORKFLOWS
    // =========================================================================
    run_assoc_regenie                     = true
    run_assoc_fastgwa                     = false
    run_assoc_kvik                        = false

    regenie_skip_predictions              = false
    phenotypes_apply_rint                 = false
    regenie_test                          = 'additive'
    regenie_force_step1                   = false
    regenie_low_mem                       = false
    regenie_firth                         = false
    regenie_firth_approx                  = false
    regenie_bsize_step1                   = 1000
    regenie_bsize_step2                   = 200
    regenie_step1_optional                = null
    regenie_step2_optional                = null
    kvik_step1_optional                   = null
    kvik_step2_optional                   = null
    genotypes_prediction_chunks           = 0


    // =========================================================================
    // HERITABILITY WORKFLOWS (INDIVIDUAL-LEVEL)
    // =========================================================================
    run_h2_gcta_grm                       = false
    run_h2_ldak_grm                       = false
    run_h2_gcta_greml                     = false
    run_h2_gcta_greml_ldms                = false
    run_h2_bolt_lmm_reml                  = false
    run_h2_ldak_reml                      = false
    run_h2_ldak_he                        = false
    run_h2_ldak_pcgc                      = false
    run_h2_ldak_qc                        = false

    heritability_model                    = 'human_default'
    nparts_gcta                           = 15
    gcta_create_sparse_grm                = false
    gcta_sparse_cutoff                    = 0.05
    ldak_adjust_grm                       = false

    // Pre-computed GRM inputs
    gcta_grm_prefix                       = "${projectDir}/grm/gcta_grm/gcta_grm_0_adj_unrel05"
    gcta_mgrm_file                        = "${projectDir}/grm/gcta_grm_ldms/gcta_grm_ldms.mgrm"
    gcta_sparse_grm_prefix                = "${projectDir}/grm/gcta_grm_sparse/gcta_grm_0_adj_unrel05_sp"
    ldak_grm_prefix                       = "${projectDir}/grm/ldak_grm/ldak_grm"
    ldak_adjusted_grm_prefix              = "${projectDir}/grm/ldak_grm_adjusted/ldak_grm_adj"

    // LDAK individual-level options
    ldak_he_subset_prefix                 = null
    ldak_he_subset_number                 = null
    ldak_reml_prevalence                  = null
    ldak_pcgc_prevalence                  = null
    batch_subset_prefix                   = null
    batch_subset_number                   = null

    // =========================================================================
    // HERITABILITY WORKFLOWS (SUMSTATS)
    // =========================================================================
    run_h2_ldak_sumher                    = false
    run_h2_ldsc_h2                        = false

    ldak_sumher_tagfile                   = null
    ldak_sumher_check_sums                = false
    ldak_sumher_prevalence                = null
    ldak_sumher_prevalence_map            = null
    ldak_sumher_ascertainment             = null
    ldak_sumher_ascertainment_map         = null
    ldak_sumher_cutoff                    = null

    // Shared LDAK sumstats preprocessing for SumHer/SumCors
    ldak_sumstats_liftover                = false
    ldak_sumstats_target_build            = 'GRCh37'
    ldak_sumstats_source_build            = 'auto'
    ldak_sumstats_frq_filter              = 0.01

    // Shared LDSC references for h2/rg
    ldsc_ref_ld_chr                       = null
    ldsc_w_ld_chr                         = null
    ldsc_h2_extra_args                    = null

    // LDSC munging options
    ldsc_munge_extra_args                 = null

    // =========================================================================
    // GENETIC CORRELATION WORKFLOWS
    // =========================================================================
    run_rg_ldak_sumcors                   = false
    run_rg_ldsc_rg                        = false
    run_rg_gcta_bivariate_greml           = false
    run_rg_gcta_bivariate_greml_ldms      = false

    ldak_sumcors_tagfile                  = null
    ldak_sumcors_check_sums               = false
    ldak_sumcors_summary_stats1           = null
    ldak_sumcors_summary_stats2           = null
    ldsc_rg_extra_args                    = null
    gcta_bivariate_phenotype1             = null
    gcta_bivariate_phenotype2             = null

    // =========================================================================
    // GENE-BASED ASSOCIATIONS (MAGMA)
    // =========================================================================
    run_magma_gene_based                  = false
    run_magma_gene_set                    = false

    magma_reference_plink                 = null
    magma_gene_annot                      = null
    magma_gene_loc                        = null
    magma_set_annot                       = null
    magma_gene_results_dir                = null

    magma_gene_input_mode                 = 'sumstats'
    magma_raw_extra_args                  = null

    magma_window_up_kb                    = 35
    magma_window_down_kb                  = 10
    magma_gene_model                      = null
    magma_gene_extra_args                 = null
    magma_set_model                       = null
    magma_set_extra_args                  = null

    // =========================================================================
    // OTHER WORKFLOWS
    // =========================================================================
    run_lava_local_rg                     = false
    run_lcv_causal                        = false

    lava_analysis_id                      = 'lava_local_rg'
    lava_ref_plink                        = null
    lava_loci_file                        = null
    lava_sample_overlap_file              = null
    lava_univ_threshold                   = 0.05

    lcv_analysis_id                       = 'lcv_causal'
    lcv_ldscores_file                     = null
    lcv_sumstats_trait1                   = null
    lcv_sumstats_trait2                   = null
    lcv_trait1_name                       = null
    lcv_trait2_name                       = null
    lcv_no_blocks                         = 100
    lcv_sig_threshold                     = 30
    lcv_crosstrait_intercept              = 1
    lcv_ldsc_intercept                    = 1

    // Utility toggles
    run_munge_sumstats                    = false
    munge_genome_build                    = 'GRCh38'
    munge_dbsnp_version                   = 0
}

// Load base configuration
// includeConfig 'conf/base.config'

// Define profiles
profiles {
    debug {
        process.beforeScript = 'echo $HOSTNAME'
    }

    // =============================================================================
    // TEST PROFILES
    // =============================================================================
    // Base test profile (LDAK QC only - default)
    test {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_magma_mock.config'
        includeConfig 'conf/test_ldsc_mock.config'
    }

    // Association analysis test profiles
    test_association_regenie {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_association_regenie.config'
    }

    test_association_fastgwa {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_association_fastgwa.config'
    }

    test_gene_magma {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_magma_mock.config'
        includeConfig 'conf/test_gene_magma.config'
    }

    test_gene_magma_raw {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_magma_mock.config'
        includeConfig 'conf/test_gene_magma_raw.config'
    }

    test_geneset_magma {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_magma_mock.config'
        includeConfig 'conf/test_geneset_magma.config'
    }

    test_gene_and_geneset_magma {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_magma_mock.config'
        includeConfig 'conf/test_gene_and_geneset_magma.config'
    }

    // Heritability estimation test profiles
    test_heritability_gcta {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_gcta.config'
    }

    test_heritability_ldak_reml {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_reml.config'
    }

    test_heritability_ldak_he {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_he.config'
    }

    test_heritability_ldak_pcgc {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_pcgc.config'
    }

    test_heritability_ldak_qc {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldak_qc.config'
    }

    test_heritability_bolt {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_bolt.config'
    }


    test_heritability_ldsc_h2 {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_heritability_ldsc_h2.config'
    }

    // Genetic correlation test profiles
    test_genetic_correlation_ldsc_rg {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_genetic_correlation_ldsc_rg.config'
    }

    // GRM-only computation test profiles
    test_grm_gcta {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_grm_gcta.config'
    }

    test_grm_gcta_ldms {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_grm_gcta_ldms.config'
    }

    test_grm_ldak {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_grm_ldak.config'
    }

    // Comprehensive test profile (all workflows)
    test_all {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_all_workflows.config'
    }

    // Input format test profiles (PLINK1/PLINK2 instead of VCF)
    test_plink1_input {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_plink1_input.config'
    }

    test_plink2_input {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_plink2_input.config'
    }

    test_plink_both {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_plink_both.config'
    }

    // =============================================================================
    // EXECUTION ENVIRONMENT PROFILES
    // =============================================================================
    singularity {
        process.container       = "${projectDir}/nf-gwas.sif"
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
        process.shell = ['/usr/bin/env', 'bash', '-euo', 'pipefail']
    }

    docker {
        docker.enabled          = true
        singularity.enabled     = false
    }

    development {
        resume = true
    }

    slurm {
        process.executor = 'slurm'
    }

    slurm_with_scratch {
        process {
            executor = 'slurm'
            scratch  = true
        }
    }
}
