Bootstrap: docker
From: ubuntu:22.04

%files
    environment.yml /opt/environment.yml

%environment
    export PATH=/opt/conda/bin:${PATH}
    export PATH=/opt/jbang/bin:${PATH}
    export PATH=/opt/regenie:${PATH}
    export PATH=/opt/ldak:${PATH}
    export PATH=/opt/magma:${PATH}
    export JAVA_TOOL_OPTIONS="-Djdk.lang.Process.launchMechanism=vfork"
    export GENOMIC_UTILS_VERSION="v0.3.7"
    export REGENIE_VERSION="v3.4"

%post
    # Update system packages and install all dependencies first
    # Including build tools needed for compiling R/Bioconductor packages
    apt-get update && apt-get install -y \
        wget \
        build-essential \
        gcc \
        g++ \
        make \
        gfortran \
        python3 \
        zlib1g-dev \
        libgomp1 \
        procps \
        libx11-6 \
        unzip \
        curl \
        libxml2-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libbz2-dev \
        liblzma-dev \
        libpcre2-dev \
        libicu-dev

    # Install Mambaforge (includes mamba by default)
    wget https://github.com/conda-forge/miniforge/releases/download/25.3.1-0/Miniforge3-25.3.1-0-Linux-x86_64.sh
    bash Miniforge3-25.3.1-0-Linux-x86_64.sh -b -p /opt/conda
    rm Miniforge3-25.3.1-0-Linux-x86_64.sh

    # Add to PATH
    export PATH="/opt/conda/bin:$PATH"

    mamba env update -n base -f /opt/environment.yml
    mamba clean --all -y

    # Verify MungeSumstats installation (installed via conda from bioconda)
    /opt/conda/bin/Rscript -e "library(MungeSumstats); packageVersion('MungeSumstats')"

    # Install LAVA R package from GitHub (for local genetic correlation analysis)
    /opt/conda/bin/Rscript -e "if (!require('remotes', quietly=TRUE)) install.packages('remotes', repos='https://cloud.r-project.org'); remotes::install_github('josefin-werme/LAVA')"
    # Verify LAVA installation
    /opt/conda/bin/Rscript -e "library(LAVA); packageVersion('LAVA')"

    # Clean up apt cache
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Install jbang
    cd /opt
    wget https://github.com/jbangdev/jbang/releases/download/v0.91.0/jbang-0.91.0.zip
    unzip -q jbang-*.zip
    mv jbang-0.91.0 jbang
    rm jbang*.zip
    export PATH="/opt/jbang/bin:${PATH}"

    # Install genomic-utils
    cd /opt
    wget https://github.com/genepi/genomic-utils/releases/download/v0.3.7/genomic-utils.jar

    # Install regenie
    cd /opt
    mkdir regenie && cd regenie
    wget https://github.com/rgcgithub/regenie/releases/download/v3.4/regenie_v3.4.gz_x86_64_Linux.zip
    unzip -q regenie_v3.4.gz_x86_64_Linux.zip
    rm regenie_v3.4.gz_x86_64_Linux.zip
    mv regenie_v3.4.gz_x86_64_Linux regenie
    chmod +x regenie

    # Install LDAK
    cd /opt
    mkdir -p ldak && cd ldak
    wget https://raw.githubusercontent.com/dougspeed/LDAK/main/ldak6.2.linux
    chmod +x ldak6.2.linux
    ln -s ldak6.2.linux ldak6

    # Install MAGMA (official Linux binary)
    cd /opt
    MAGMA_URL="https://vu.data.surf.nl/index.php/s/lxDgt2dNdNr6DYt/download"
    MAGMA_SHA256="d8b20778b773f47b4fb0f1020baefebc92b11ee65946e708a618d494d6819e39"
    wget -O magma.zip "${MAGMA_URL}"
    echo "${MAGMA_SHA256}  magma.zip" | sha256sum -c -
    unzip -q magma.zip -d /opt/magma
    rm magma.zip
    chmod +x /opt/magma/magma
    /opt/magma/magma --version || /opt/magma/magma || true

    # Install LDSC (Python package)
    /opt/conda/bin/pip install 'pandas<3' ldsc==2.0.1

%runscript
    exec "$@"

%labels
    Author nf-gwas
    Version v1.0
    Description Singularity container for nf-gwas pipeline with all required dependencies

%help
    This container includes all dependencies for the nf-gwas pipeline:
    - Conda with bioinformatics packages (plink, plink2, gcta, bolt-lmm, etc.)
    - LDAK6 for heritability and genetic correlation analysis
    - LAVA R package for local genetic correlation analysis
    - Java tools (jbang, genomic-utils)
    - Regenie for GWAS analysis
    - MAGMA for gene and gene-set analyses
    - MungeSumstats (Bioconductor) for standardizing GWAS summary statistics

    Usage:
    singularity exec nf-gwas.sif <command>

    Example:
    singularity exec nf-gwas.sif nextflow run main.nf
