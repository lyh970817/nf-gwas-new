nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Pipeline guard: fail when no workflows are enabled") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_assoc_regenie                 = false
                run_assoc_fastgwa                 = false
                run_assoc_kvik                    = false
                run_h2_gcta_grm                   = false
                run_h2_ldak_grm                   = false
                run_h2_gcta_greml                 = false
                run_h2_gcta_greml_ldms            = false
                run_h2_bolt_lmm_reml              = false
                run_h2_ldak_reml                  = false
                run_h2_ldak_he                    = false
                run_h2_ldak_pcgc                  = false
                run_h2_ldak_qc                    = false
                run_h2_ldak_sumher                = false
                run_h2_ldsc_h2                    = false
                run_rg_ldak_sumcors               = false
                run_rg_ldsc_rg                    = false
                run_rg_gcta_bivariate_greml       = false
                run_rg_gcta_bivariate_greml_ldms  = false
                run_magma_gene_based              = false
                run_magma_gene_set                = false
                run_lava_local_rg                 = false
                run_lcv_causal                    = false
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail on removed legacy parameter") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_set                = true
                run_gene_set_analysis             = true
                magma_set_annot                   = "$projectDir/tests/input/magma/geneset/set_annot.sets.annot"
                magma_gene_results_dir            = "$projectDir/tests/input/magma/gene_results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail on removed REGENIE gene-based flag") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_set                = true
                magma_set_annot                   = "$projectDir/tests/input/magma/geneset/set_annot.sets.annot"
                magma_gene_results_dir            = "$projectDir/tests/input/magma/gene_results"
                regenie_step2_optional            = "--anno-file removed_feature_input"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail on invalid MAGMA input mode") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_based              = true
                magma_gene_input_mode             = 'invalid-mode'
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail when raw MAGMA is missing phenotypes") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_based              = true
                magma_gene_input_mode             = 'raw'
                phenotypes_dir                    = null
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail when raw MAGMA is missing genotype files") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_based              = true
                magma_gene_input_mode             = 'raw'
                phenotypes_dir                    = "$projectDir/tests/input/phenotypes/single"
                imputed_genotyped_files_vcf       = null
                imputed_genotyped_files_plink1    = null
                imputed_genotyped_files_plink2    = null
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail on removed magma_use_regenie_merged parameter") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_based              = true
                magma_use_regenie_merged          = true
                magma_reference_plink             = "$projectDir/tests/input/magma/ref.{bed,bim,fam}"
                magma_gene_loc                    = "$projectDir/tests/input/magma/genes.loc"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail when gene-set has no pipeline run and no external gene results") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_based              = false
                run_magma_gene_set                = true
                magma_set_annot                   = "$projectDir/tests/input/magma/geneset/set_annot.sets.annot"
                magma_gene_results_dir            = null
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail on removed magma_use_pipeline_gene_results parameter") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_set                = true
                magma_set_annot                   = "$projectDir/tests/input/magma/geneset/set_annot.sets.annot"
                magma_use_pipeline_gene_results   = true
                magma_gene_results_dir            = "$projectDir/tests/input/magma/gene_results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail when genetic-correlation has fewer than two summary stats") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_rg_ldsc_rg                    = true
                summary_stats_dir                 = "$projectDir/tests/input/magma/gene_results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail when MAGMA sumstats mode has no reference PLINK") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_magma_gene_based              = true
                run_magma_gene_set                = false
                magma_gene_input_mode             = 'sumstats'
                magma_reference_plink             = null
                magma_gene_loc                    = "$projectDir/tests/input/magma/genes.loc"
                summary_stats_dir                 = "$projectDir/tests/input/magma/sumstats"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail when KVIK is enabled without genotyped input") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_assoc_regenie                 = false
                run_assoc_kvik                    = true
                genotyped_file                    = null
                imputed_genotyped_files_vcf       = "$projectDir/tests/input/chr01.vcf.gz"
                phenotypes_dir                    = "$projectDir/tests/input/phenotypes/single"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("Pipeline guard: fail on removed use_precomputed_grm parameter") {

        tag "main_pipeline"
        tag "main_negative"

        when {
            params {
                pubDir                            = "$outputDir/results"
                run_h2_gcta_greml                 = true
                use_precomputed_grm               = true
                phenotypes_dir                    = "$projectDir/tests/input/phenotypes/single"
                imputed_genotyped_files_vcf       = "$projectDir/tests/input/chr01.vcf.gz"
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
        }
    }
}
