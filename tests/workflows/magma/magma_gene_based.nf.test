nextflow_workflow {

    name "Test MAGMA_GENE_BASED"
    script "workflows/magma/magma_gene_based.nf"
    workflow "MAGMA_GENE_BASED"

    test("Should run MAGMA gene workflow with generated annotation") {

        when {
            params {
                pubDir = "$outputDir/results"
                sumstats_log10p_col = null
                sumstats_snp_col = 'SNP'
                sumstats_p_col = 'P'
                sumstats_n = 500
                sumstats_n_col = null
                magma_window_up_kb = 35
                magma_window_down_kb = 10
                magma_gene_model = null
                magma_gene_extra_args = null
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple('trait1', file("$projectDir/tests/input/magma/sumstats/trait1.tsv")),
                    tuple('trait2', file("$projectDir/tests/input/magma/sumstats/trait2.tsv"))
                )

                input[1] = Channel.of(tuple(
                    'ref',
                    file("$projectDir/tests/input/magma/ref.bed"),
                    file("$projectDir/tests/input/magma/ref.bim"),
                    file("$projectDir/tests/input/magma/ref.fam")
                ))

                input[2] = []
                input[3] = file("$projectDir/tests/input/magma/genes.loc")
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out.gene_results) {
                assert size() == 2
            }
            with(workflow.out.gene_results_raw) {
                assert size() == 2
            }
        }
    }
}
