nextflow_workflow {

    name "Test Workflow GCTA_GREML"
    script "workflows/gcta/gcta_greml.nf"
    workflow "GCTA_GREML"

    test("Should perform GREML heritability estimation without covariates") {

        when {
            params {
                nparts_gcta = 2
            }
            workflow {
                """
                // Phenotype meta channel
                input[0] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/gcta/phenotype_single.txt"),
                    false
                ))

                // Covariate file (none)
                input[1] = []

                // PLINK2 files channel
                input[2] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                // nparts_gcta parameter
                input[3] = 2
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out) {
                assert grm_files
                assert reml_results
                assert snapshot(grm_files, reml_results).match()
            }
        }
    }

    test("Should perform GREML with quantitative and categorical covariates") {

        when {
            params {
                covariates_columns = 'V1,V2,V3'
                covariates_cat_columns = 'V1'
                nparts_gcta = 2
            }
            workflow {
                """
                input[0] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/gcta/phenotype_single.txt"),
                    false
                ))
                input[1] = file("$projectDir/tests/input/gcta/covariates.txt")

                input[2] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                input[3] = 2
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out) {
                assert grm_files
                assert reml_results
                assert snapshot(grm_files, reml_results).match()
            }
        }
    }

    test("Should handle single phenotype with different nparts value") {

        when {
            params {
                nparts_gcta = 1
            }
            workflow {
                """
                input[0] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/gcta/phenotype_single.txt"),
                    false
                ))
                input[1] = []

                input[2] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                input[3] = 1
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out) {
                assert grm_files
                assert reml_results
                assert snapshot(grm_files, reml_results).match()
            }
        }
    }
}
