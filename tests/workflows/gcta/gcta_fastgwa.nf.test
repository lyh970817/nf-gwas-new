nextflow_workflow {

    name "Test Workflow GCTA_FASTGWA"
    script "workflows/gcta/gcta_fastgwa.nf"
    workflow "GCTA_FASTGWA"

    test("Should perform FastGWA association testing without covariates") {

        when {
            params {
                nparts_gcta = 2
            }
            workflow {
                """
                // PLINK2 files channel
                input[0] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                // Phenotype meta channel
                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/gcta/phenotype_single.txt"),
                    false
                ))

                // Covariate file
                input[2] = []

                // nparts_gcta
                input[3] = 2

                // sparse cutoff
                input[4] = 0.05
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out) {
                assert grm_files
                assert sparse_grm_files
                assert fastgwa_results
                assert snapshot(grm_files, sparse_grm_files, fastgwa_results).match()
            }
        }
    }

    test("Should perform FastGWA with quantitative and categorical covariates") {

        when {
            params {
                covariates_columns = 'V1,V2,V3'
                covariates_cat_columns = 'V1'
                nparts_gcta = 2
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/gcta/phenotype_single.txt"),
                    false
                ))
                input[2] = file("$projectDir/tests/input/gcta/covariates.txt")
                input[3] = 2
                input[4] = 0.05
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out) {
                assert grm_files
                assert sparse_grm_files
                assert fastgwa_results
                assert snapshot(grm_files, sparse_grm_files, fastgwa_results).match()
            }
        }
    }

    test("Should perform FastGWA with different sparse cutoff") {

        when {
            params {
                nparts_gcta = 2
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/gcta/phenotype_single.txt"),
                    false
                ))
                input[2] = []
                input[3] = 2
                // Use stricter sparse cutoff (0.02)
                input[4] = 0.02
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out) {
                assert grm_files
                assert sparse_grm_files
                assert fastgwa_results
                assert snapshot(grm_files, sparse_grm_files, fastgwa_results).match()
            }
        }
    }
}
