nextflow_workflow {

    name "Test Workflow GCTA_GRM"
    script "workflows/gcta/gcta_grm.nf"
    workflow "GCTA_GRM"

    test("Should calculate GRM without SNP group filtering") {

        when {
            params {
                nparts_gcta = 2
            }
            workflow {
                """
                // Create PLINK2 channel input
                input[0] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                // nparts_gcta parameter
                input[1] = 2

                // SNP group channel (empty - no filtering)
                input[2] = Channel.of(["0", []])

                // Sparse GRM and relatedness filtering settings
                input[3] = false
                input[4] = 0.05
                input[5] = false
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert grm_files
                assert adjusted_grm_files
                assert keep_file
                assert snapshot(grm_files, adjusted_grm_files, keep_file).match()
            }
        }
    }

    test("Should calculate GRM with reduced parallelization") {

        when {
            params {
                nparts_gcta = 1
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/gcta/chr01.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr01.vcf.pvar"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/gcta/chr02.vcf.pgen"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.psam"),
                        file("$projectDir/tests/input/gcta/chr02.vcf.pvar"),
                        null
                    )
                )

                input[1] = 1

                input[2] = Channel.of(["0", []])

                input[3] = false
                input[4] = 0.05
                input[5] = false
                """
            }
        }

        then {
            assert workflow.success
            with(workflow.out) {
                assert grm_files
                assert adjusted_grm_files
                assert keep_file
                assert snapshot(grm_files, adjusted_grm_files, keep_file).match()
            }
        }
    }
}
