nextflow_workflow {

    name "Test Workflow LDAK_PCGC_WORKFLOW"
    script "workflows/ldak/ldak_pcgc.nf"
    workflow "LDAK_PCGC_WORKFLOW"

    test("LDAK PCGC: Should execute PCGC regression with binary trait and prevalence") {

        when {
            params {
                // LDAK PCGC specific parameters
                ldak_run_pcgc = true
                ldak_pcgc_prevalence = 0.2
                ldak_heritability_model = 'human_default'
                covariates_columns = 'V1,V2,V3'
                covariates_cat_columns = 'V1'
            }
            workflow {
                """
                // Prepare PLINK input channel: [chr_num, filename, bed, bim, fam, range]
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/ldak/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                // Binary phenotype meta channel
                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/bin/phenotype_bin_Y1.txt"),
                    true
                ))

                // Covariates file
                input[2] = file("$projectDir/tests/input/ldak/covariates.txt")

                // Heritability model
                input[3] = 'human_default'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                // Check that PCGC results exist
                assert pcgc_results
                assert pcgc_results.get(0) != null

                // Check kinship matrices were created
                assert ldak_grm
                assert ldak_grm.size() > 0

                // Check combined GRM exists
                assert combined_grm
                assert combined_grm.get(0) != null

                // Check filtered list exists
                assert filtered_list
                assert filtered_list.get(0) != null

                def pcgcFiles = pcgc_results.get(0).get(1)
                def pcgcFile = pcgcFiles instanceof java.util.List
                    ? pcgcFiles.find { path(it).fileName.toString().endsWith('.pcgc') }
                    : pcgcFiles
                assert pcgcFile
                def pcgcPath = path(pcgcFile)
                assert pcgcPath.text.contains("Num_Kinships")
            }
        }
    }

    test("LDAK PCGC: Should execute without covariates") {

        when {
            params {
                ldak_run_pcgc = true
                ldak_pcgc_prevalence = 0.15
                ldak_heritability_model = 'human_default'
                covariates_columns = ''
                covariates_cat_columns = ''
            }
            workflow {
                """
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/ldak/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/bin/phenotype_bin_Y1.txt"),
                    true
                ))
                input[2] = []  // No covariates
                input[3] = 'human_default'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert pcgc_results
                assert pcgc_results.get(0) != null

                def pcgcFiles = pcgc_results.get(0).get(1)
                def pcgcFile = pcgcFiles instanceof java.util.List
                    ? pcgcFiles.find { path(it).fileName.toString().endsWith('.pcgc') }
                    : pcgcFiles
                assert pcgcFile
                def pcgcPath = path(pcgcFile)
                assert pcgcPath.text.contains("Num_Kinships")
            }
        }
    }

