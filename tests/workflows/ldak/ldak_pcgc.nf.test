nextflow_workflow {

    name "Test Workflow LDAK_PCGC_WORKFLOW"
    script "workflows/ldak/ldak_pcgc.nf"
    workflow "LDAK_PCGC_WORKFLOW"

    test("LDAK PCGC: Should execute PCGC regression with binary trait and prevalence") {

        when {
            params {
                // LDAK PCGC specific parameters
                ldak_run_pcgc = true
                ldak_pcgc_prevalence = 0.2
                ldak_heritability_model = 'human_default'
                phenotypes_columns = 'Y_bin'
            }
            workflow {
                """
                // Prepare PLINK input channel: [chr_num, filename, bed, bim, fam, range]
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/pipeline/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                // Binary phenotype file
                input[1] = file("$projectDir/tests/input/pipeline/phenotype_bin.txt")

                // Covariates file
                input[2] = file("$projectDir/tests/input/pipeline/covariates.txt")

                // Heritability model
                input[3] = 'human_default'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                // Check that PCGC results exist
                assert pcgc_results
                assert pcgc_results.get(0) != null

                // Check kinship matrices were created
                assert ldak_grm
                assert ldak_grm.size() > 0

                // Check combined GRM exists
                assert combined_grm
                assert combined_grm.get(0) != null

                // Check filtered list exists
                assert filtered_list
                assert filtered_list.get(0) != null

                // Snapshot PCGC results
                assert snapshot(pcgc_results).match()
            }
        }
    }

    test("LDAK PCGC: Should execute without covariates") {

        when {
            params {
                ldak_run_pcgc = true
                ldak_pcgc_prevalence = 0.15
                ldak_heritability_model = 'human_default'
                phenotypes_columns = 'Y_bin'
            }
            workflow {
                """
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/pipeline/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                input[1] = file("$projectDir/tests/input/pipeline/phenotype_bin.txt")
                input[2] = []  // No covariates
                input[3] = 'human_default'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert pcgc_results
                assert pcgc_results.get(0) != null

                assert snapshot(pcgc_results).match("pcgc_no_covariates")
            }
        }
    }

    test("LDAK PCGC: Should work with different prevalence values") {

        when {
            params {
                ldak_run_pcgc = true
                ldak_pcgc_prevalence = 0.05  // 5% disease prevalence
                ldak_heritability_model = 'human_default'
                phenotypes_columns = 'Y_bin'
            }
            workflow {
                """
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/pipeline/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                input[1] = file("$projectDir/tests/input/pipeline/phenotype_bin.txt")
                input[2] = file("$projectDir/tests/input/pipeline/covariates.txt")
                input[3] = 'human_default'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert pcgc_results
                assert pcgc_results.get(0) != null

                assert snapshot(pcgc_results).match("pcgc_prevalence_005")
            }
        }
    }

    test("LDAK PCGC: Should work with uniform model") {

        when {
            params {
                ldak_run_pcgc = true
                ldak_pcgc_prevalence = 0.2
                ldak_heritability_model = 'uniform'
                phenotypes_columns = 'Y_bin'
            }
            workflow {
                """
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/pipeline/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                input[1] = file("$projectDir/tests/input/pipeline/phenotype_bin.txt")
                input[2] = file("$projectDir/tests/input/pipeline/covariates.txt")
                input[3] = 'uniform'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert pcgc_results
                assert ldak_grm

                assert snapshot(pcgc_results).match("pcgc_uniform_model")
            }
        }
    }
}
