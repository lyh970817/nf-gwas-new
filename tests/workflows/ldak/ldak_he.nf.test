nextflow_workflow {

    name "Test Workflow LDAK_HE_WORKFLOW"
    script "workflows/ldak/ldak_he.nf"
    workflow "LDAK_HE_WORKFLOW"

    test("LDAK HE: Should execute HE regression with quantitative trait") {

        when {
            params {
                // LDAK HE specific parameters
                ldak_use_he_regression = true
                ldak_heritability_model = 'human_default'
                ldak_he_subset_prefix = null
                ldak_he_subset_number = null
                covariates_columns = 'V1,V2,V3'
                covariates_cat_columns = 'V1'
            }
            workflow {
                """
                // Prepare PLINK input channel: [chr_num, filename, bed, bim, fam, range]
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/ldak/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                // Phenotype meta channel
                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt"),
                    false
                ))

                // Covariates file
                input[2] = file("$projectDir/tests/input/ldak/covariates.txt")

                // Heritability model
                input[3] = 'human_default'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                // Check that HE results exist
                assert he_results
                assert he_results.get(0) != null

                // Check kinship matrices were created
                assert ldak_grm
                assert ldak_grm.size() > 0

                // Check combined GRM exists
                assert combined_grm
                assert combined_grm.get(0) != null

                // Check filtered list exists
                assert filtered_list
                assert filtered_list.get(0) != null

                def heFiles = he_results.get(0).get(1)
                def heFile = heFiles instanceof java.util.List
                    ? heFiles.find { path(it).fileName.toString().endsWith('.he') }
                    : heFiles
                assert heFile
                def hePath = path(heFile)
                assert hePath.text.contains("Num_Kinships")
            }
        }
    }

    test("LDAK HE: Should execute without covariates") {

        when {
            params {
                ldak_use_he_regression = true
                ldak_heritability_model = 'human_default'
                ldak_he_subset_prefix = null
                ldak_he_subset_number = null
                covariates_columns = ''
                covariates_cat_columns = ''
            }
            workflow {
                """
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/ldak/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt"),
                    false
                ))
                input[2] = []  // No covariates
                input[3] = 'human_default'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert he_results
                assert he_results.get(0) != null

                def heFiles = he_results.get(0).get(1)
                def heFile = heFiles instanceof java.util.List
                    ? heFiles.find { path(it).fileName.toString().endsWith('.he') }
                    : heFiles
                assert heFile
                def hePath = path(heFile)
                assert hePath.text.contains("Num_Kinships")
            }
        }
    }

    test("LDAK HE: Should work with uniform model") {

        when {
            params {
                ldak_use_he_regression = true
                ldak_heritability_model = 'uniform'
                ldak_he_subset_prefix = null
                ldak_he_subset_number = null
                covariates_columns = 'V1,V2,V3'
                covariates_cat_columns = 'V1'
            }
            workflow {
                """
                input[0] = Channel.fromFilePairs(
                    "$projectDir/tests/input/ldak/example.{bed,bim,fam}",
                    size: 3,
                    flat: true
                ).map { filename_base, bed, bim, fam ->
                    [1, filename_base, bed, bim, fam, null]
                }

                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt"),
                    false
                ))
                input[2] = file("$projectDir/tests/input/ldak/covariates.txt")
                input[3] = 'uniform'
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert he_results
                assert ldak_grm

                def heFiles = he_results.get(0).get(1)
                def heFile = heFiles instanceof java.util.List
                    ? heFiles.find { path(it).fileName.toString().endsWith('.he') }
                    : heFiles
                assert heFile
                def hePath = path(heFile)
                assert hePath.text.contains("Num_Kinships")
            }
        }
    }
}
