nextflow_workflow {

    name "Test Workflow LDAK_QC"
    script "workflows/ldak/ldak_qc.nf"
    workflow "LDAK_QC"

    test("LDAK QC: Should execute QC with 2 chromosomes (2 quarters)") {

        when {
            params {
                ldak_heritability_model = 'human_default'
                batch_subset_prefix = null
                batch_subset_number = null
            }
            workflow {
                """
                // Prepare PLINK input channel for 2 chromosomes
                input[0] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/ldak/chr01.vcf.bed"),
                        file("$projectDir/tests/input/ldak/chr01.vcf.bim"),
                        file("$projectDir/tests/input/ldak/chr01.vcf.fam"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/ldak/chr02.vcf.bed"),
                        file("$projectDir/tests/input/ldak/chr02.vcf.bim"),
                        file("$projectDir/tests/input/ldak/chr02.vcf.fam"),
                        null
                    )
                )

                // Phenotype meta channel
                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt"),
                    false
                ))

                // Covariates file
                input[2] = file("$projectDir/tests/input/ldak/covariates.txt")
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                // Check quarter REML results exist
                assert quarter_reml_results
                def quarter_results = quarter_reml_results.toList()
                assert quarter_results.size() == 2 : "Expected 2 quarter results for 2 chromosomes"

                // Check inflation results exist
                assert inflation_results
                assert inflation_results.get(0) != null

                // Genotype error should be empty (no batch params)
                def ge_results = genotype_error_results.toList()
                assert ge_results.size() == 0 : "Expected no genotype error results without batch params"

                def inflationFile = path(inflation_results.get(0).get(1))
                assert inflationFile.text.contains("LDAK Inflation Analysis Results")
            }
        }
    }


    test("LDAK QC: Should execute without covariates") {

        when {
            params {
                ldak_heritability_model = 'human_default'
                batch_subset_prefix = null
                batch_subset_number = null
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple(
                        1,
                        "chr01.vcf",
                        file("$projectDir/tests/input/ldak/chr01.vcf.bed"),
                        file("$projectDir/tests/input/ldak/chr01.vcf.bim"),
                        file("$projectDir/tests/input/ldak/chr01.vcf.fam"),
                        null
                    ),
                    tuple(
                        2,
                        "chr02.vcf",
                        file("$projectDir/tests/input/ldak/chr02.vcf.bed"),
                        file("$projectDir/tests/input/ldak/chr02.vcf.bim"),
                        file("$projectDir/tests/input/ldak/chr02.vcf.fam"),
                        null
                    )
                )

                input[1] = Channel.of(tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt"),
                    false
                ))
                input[2] = []  // No covariates
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert quarter_reml_results
                assert inflation_results

                def inflationFile = path(inflation_results.get(0).get(1))
                assert inflationFile.text.contains("LDAK Inflation Analysis Results")
            }
        }
    }

}
