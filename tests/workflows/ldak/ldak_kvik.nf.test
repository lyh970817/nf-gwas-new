nextflow_workflow {

    name "Test LDAK_KVIK_WORKFLOW"
    script "workflows/ldak/ldak_kvik.nf"
    workflow "LDAK_KVIK_WORKFLOW"

    test("Should execute complete LDAK-KVIK workflow for quantitative trait") {

        when {
            workflow {
                """
                // Step 1 input: Merged genotype data with multiple chromosomes for LOCO
                // merged_chr has chr1 and chr2 (2000 variants)
                step1_plink_ch = Channel.of(
                    tuple(
                        "merged_chr",
                        file("\$projectDir/tests/input/ldak/merged_chr.bed"),
                        file("\$projectDir/tests/input/ldak/merged_chr.bim"),
                        file("\$projectDir/tests/input/ldak/merged_chr.fam")
                    )
                )

                // Step 2 input: Per-chromosome imputed PLINK files
                imputed_plink_ch = Channel.of(
                    tuple(1, "chr01.vcf", file("\$projectDir/tests/input/ldak/chr01.vcf.bed"), file("\$projectDir/tests/input/ldak/chr01.vcf.bim"), file("\$projectDir/tests/input/ldak/chr01.vcf.fam"), null),
                    tuple(2, "chr02.vcf", file("\$projectDir/tests/input/ldak/chr02.vcf.bed"), file("\$projectDir/tests/input/ldak/chr02.vcf.bim"), file("\$projectDir/tests/input/ldak/chr02.vcf.fam"), null)
                )

                input[0] = step1_plink_ch
                input[1] = imputed_plink_ch
                input[2] = Channel.of(tuple(
                    "Y1",
                    file("\$projectDir/tests/input/ldak/phenotype_single.txt"),
                    false
                ))
                input[3] = file("\$projectDir/tests/input/ldak/covariates.txt")
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                // Verify Step 1 outputs
                assert step1_outputs
                assert step1_root
                assert step1_loco_prs

                // Verify merged Step 2 results
                assert merged_assoc
                assert merged_summaries


                def assocFile = merged_assoc.get(0).get(1)
                def assocPath = assocFile instanceof java.util.List ? path(assocFile[0]) : path(assocFile)
                assert assocPath.text.contains("Chromosome")
                assert assocPath.text.contains("Wald_P")
            }
        }
    }

    test("Should execute LDAK-KVIK workflow without covariates") {

        when {
            workflow {
                """
                // Use merged_chr with multiple chromosomes for LOCO
                step1_plink_ch = Channel.of(
                    tuple(
                        "merged_chr",
                        file("\$projectDir/tests/input/ldak/merged_chr.bed"),
                        file("\$projectDir/tests/input/ldak/merged_chr.bim"),
                        file("\$projectDir/tests/input/ldak/merged_chr.fam")
                    )
                )

                imputed_plink_ch = Channel.of(
                    tuple(1, "chr01.vcf", file("\$projectDir/tests/input/ldak/chr01.vcf.bed"), file("\$projectDir/tests/input/ldak/chr01.vcf.bim"), file("\$projectDir/tests/input/ldak/chr01.vcf.fam"), null),
                    tuple(2, "chr02.vcf", file("\$projectDir/tests/input/ldak/chr02.vcf.bed"), file("\$projectDir/tests/input/ldak/chr02.vcf.bim"), file("\$projectDir/tests/input/ldak/chr02.vcf.fam"), null)
                )

                input[0] = step1_plink_ch
                input[1] = imputed_plink_ch
                input[2] = Channel.of(tuple(
                    "Y1",
                    file("\$projectDir/tests/input/ldak/phenotype_single.txt"),
                    false
                ))
                input[3] = []  // No covariates
                """
            }
        }

        then {
            assert workflow.success

            with(workflow.out) {
                assert step1_outputs
                assert merged_assoc

                def assocFile = merged_assoc.get(0).get(1)
                def assocPath = assocFile instanceof java.util.List ? path(assocFile[0]) : path(assocFile)
                assert assocPath.text.contains("Chromosome")
                assert assocPath.text.contains("Wald_P")
            }
        }
    }

