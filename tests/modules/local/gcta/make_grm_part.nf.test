nextflow_process {

    name "Test Process MAKE_GRM_PART"
    script "modules/local/gcta/make_grm_part.nf"
    process "MAKE_GRM_PART"

    test("Should calculate GRM partition without SNP groups") {

        when {
            process {
                """
                input[0] = file("$projectDir/tests/input/gcta/make_grm_part/gcta_grm.mpfile")
                input[1] = tuple(1, 3, null, [])  // part 1 of 3, no SNP group
                input[2] = Channel.fromFilePairs(
                    "$projectDir/tests/input/chr*.vcf.{pgen,psam,pvar}",
                    size: 3,
                    flat: true
                ).map { filename, pgen, psam, pvar -> [pgen, psam, pvar] }.collect()
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert grm_files
                def grmTuple = grm_files.get(0)

                // Should have: nparts_gcta, snp_group, grm.id, grm.bin, grm.N.bin
                assert grmTuple.size() == 5
                assert grmTuple.get(0) == 3  // nparts_gcta
                assert grmTuple.get(1) == null  // no snp_group

                // Check GRM files exist
                def grmId = path(grmTuple.get(2))
                def grmBin = path(grmTuple.get(3))
                def grmN = path(grmTuple.get(4))

                assert grmId.fileName.toString().matches("gcta_grm_0\\.part_3_1\\.grm\\.id")
                assert grmBin.fileName.toString().matches("gcta_grm_0\\.part_3_1\\.grm\\.bin")
                assert grmN.fileName.toString().matches("gcta_grm_0\\.part_3_1\\.grm\\.N\\.bin")

                assert grmId.size() > 0
                assert grmBin.size() > 0
                assert grmN.size() > 0
            }
        }
    }

    test("Should calculate GRM partition with SNP group filtering") {

        when {
            process {
                """
                input[0] = file("$projectDir/tests/input/gcta/make_grm_part/gcta_grm.mpfile")
                input[1] = tuple(
                    2,
                    5,
                    1,
                    file("$projectDir/tests/input/gcta/make_grm_part/snp_group1.txt")
                )  // part 2 of 5, with SNP group 1
                input[2] = Channel.fromFilePairs(
                    "$projectDir/tests/input/chr*.vcf.{pgen,psam,pvar}",
                    size: 3,
                    flat: true
                ).map { filename, pgen, psam, pvar -> [pgen, psam, pvar] }.collect()
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert grm_files
                def grmTuple = grm_files.get(0)

                assert grmTuple.get(0) == 5  // nparts_gcta
                assert grmTuple.get(1) == 1  // snp_group

                def grmId = path(grmTuple.get(2))
                assert grmId.fileName.toString().matches("gcta_grm_1\\.part_5_2\\.grm\\.id")

                // Snapshot the output
                assert snapshot(grm_files).match()
            }
        }
    }
}
