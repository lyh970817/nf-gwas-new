nextflow_process {
    name "Test RUN_BIVARIATE_REML process"
    script "modules/local/gcta/run_bivariate_reml.nf"
    process "RUN_BIVARIATE_REML"

    test("Should run bivariate REML without covariates") {
        when {
            params {
                pubDir = "results"
            }
            process {
                """
                // GRM files tuple: (snp_group, prefix, grm_id, grm_bin, grm_n_bin)
                input[0] = tuple(
                    null,
                    "gcta_grm_0",
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/gcta_grm_0.grm.id"),
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/gcta_grm_0.grm.bin"),
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/gcta_grm_0.grm.N.bin")
                )
                // Phenotypes file (bivariate format: FID IID Y1 Y2, no header)
                input[1] = tuple(
                    "Y1__Y2",
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/phenotype.noheader.txt")
                )
                // No covariates
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assert process.success
            with(process.out) {
                // Check bivariate results file
                assert bivariate_results
                def resultsFile = path(bivariate_results.get(0))
                assert resultsFile.fileName.toString().endsWith(".hsq")
                assert resultsFile.size() > 0

                // Verify output contains genetic correlation estimates
                def content = resultsFile.text
                // GCTA bivariate output should contain variance components
                assert content.contains("V(G)") || content.contains("Variance") || content.contains("Source")
            }
        }
    }

    test("Should run bivariate REML with quantitative covariates") {
        when {
            params {
                pubDir = "results"
            }
            process {
                """
                input[0] = tuple(
                    null,
                    "gcta_grm_0",
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/gcta_grm_0.grm.id"),
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/gcta_grm_0.grm.bin"),
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/gcta_grm_0.grm.N.bin")
                )
                input[1] = tuple(
                    "Y1__Y2",
                    file("$projectDir/tests/input/gcta/run_bivariate_reml/phenotype.noheader.txt")
                )
                input[2] = file("$projectDir/tests/input/gcta/run_bivariate_reml/covariates.quant.noheader.txt")
                input[3] = []
                """
            }
        }

        then {
            assert process.success
            with(process.out) {
                assert bivariate_results
                def resultsFile = path(bivariate_results.get(0))
                assert resultsFile.fileName.toString().endsWith(".hsq")
            }
        }
    }
}
