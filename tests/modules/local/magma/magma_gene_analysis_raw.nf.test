nextflow_process {

    name "Test Process MAGMA_GENE_ANALYSIS_RAW"
    script "modules/local/magma/magma_gene_analysis_raw.nf"
    process "MAGMA_GENE_ANALYSIS_RAW"

    test("Should run MAGMA raw gene analysis and emit gene outputs") {

        when {
            params {
                pubDir = "$outputDir/results"
                covariates_columns = 'V2,V3'
                magma_gene_model = null
                magma_raw_extra_args = null
            }
            process {
                """
                input[0] = Channel.of(tuple(
                    'Y1',
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt"),
                    'raw',
                    file("$projectDir/tests/input/magma/ref.bed"),
                    file("$projectDir/tests/input/magma/ref.bim"),
                    file("$projectDir/tests/input/magma/ref.fam"),
                    file("$projectDir/tests/input/magma/mock.genes.annot"),
                    file("$projectDir/tests/input/covariates.txt")
                ))
                """
            }
        }

        then {
            assert process.success
            with(process.out.gene_results) {
                assert size() == 1
                def geneOut = path(get(0).get(1))
                assert geneOut.exists()
                assert geneOut.text.contains('GENE')
            }
            with(process.out.gene_results_raw) {
                assert size() == 1
                def rawOut = path(get(0).get(1))
                assert rawOut.exists()
                assert rawOut.text.contains('GENE1')
            }
        }
    }
}
