nextflow_process {

    name "Test Process IMPUTED_TO_PLINK2"
    script "modules/local/imputed_to_plink2.nf"
    process "IMPUTED_TO_PLINK2"

    test("Should create a pgen, psam and pvar file with 500 samples") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(1, file("$projectDir/tests/input/imputed_to_plink2/chr01.vcf.gz")),
                    tuple(2, file("$projectDir/tests/input/imputed_to_plink2/chr02.vcf.gz"))
                )
                """
            }
        }

        then {
            assert process.success
            with(process.out){
                assert imputed_plink2
                assert imputed_plink2.size() == 2
                    with(imputed_plink2.get(0)){
                        assert get(0) == 1
                        assert get(1) == "chr01"
                        assert get(2) ==~ ".*/chr01.pgen"
                        assert get(3) ==~ ".*/chr01.psam"
                        assert get(4) ==~ ".*/chr01.pvar"
                        assert file(get(3)).readLines().size() == 501
                }
                    with(imputed_plink2.get(1)){
                        assert get(0) == 2
                        assert get(1) == "chr02"
                        assert get(2) ==~ ".*/chr02.pgen"
                        assert get(3) ==~ ".*/chr02.psam"
                        assert get(4) ==~ ".*/chr02.pvar"
                        assert file(get(3)).readLines().size() == 501
                }

                }

        }

    }

}
