nextflow_process {

    name "Test Process REGENIE_STEP1_RUN_CHUNK"
    script "modules/local/regenie/regenie_step1_run_chunk.nf"
    process "REGENIE_STEP1_RUN_CHUNK"

    test("Should execute Step 1 on a single chunk") {

        when {
            params {
                regenie_bsize_step1 = 1000
                covariates_columns = null
                covariates_cat_columns = null
            }
            process {
                """
                // Simulate chunk input: chunk_num, master, snplists, genotype files, pheno, covar, cond
                input[0] = tuple(
                    1,  // chunk number
                    file("$projectDir/tests/input/regenie/step1_split/chunks.master"),
                    file("$projectDir/tests/input/regenie/step1_split/chunks_job1.snplist"),
                    "example",
                    [
                        file("$projectDir/tests/input/regenie/step1_run_chunk/example.bed"),
                        file("$projectDir/tests/input/regenie/step1_run_chunk/example.bim"),
                        file("$projectDir/tests/input/regenie/step1_run_chunk/example.fam")
                    ],
                    file("$projectDir/tests/input/phenotypes/basic/phenotype_Y1.txt"),
                    [],  // no covariates
                    "Y1",
                    false
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                // Check chunk outputs
                assert regenie_step1_out
                def chunkTuple = regenie_step1_out.get(0)
                def chunkFiles = chunkTuple.get(1)

                // Should produce LOCO files
                if (chunkFiles instanceof java.util.List) {
                    def locoFiles = chunkFiles.findAll { path(it).fileName.toString().contains("_l0_") }
                    assert locoFiles.size() > 0
                    locoFiles.each { file ->
                        def chunkPath = path(file)
                        assert chunkPath.fileName.toString().matches("chunks_job1_l0_.*")
                    }
                } else {
                    assert path(chunkFiles).fileName.toString().contains("chunks_job1")
                }

                // Check log file
                assert regenie_step1_out_log
                def logFile = path(regenie_step1_out_log.get(0))
                assert logFile.fileName.toString() == "chunks_job1.log"
                assert logFile.text.contains("--step 1")
                assert logFile.text.contains("--run-l0")
            }
        }
    }

    test("Should handle chunk with covariates") {

        when {
            params {
                covariates_columns = 'V1,V2'
                covariates_cat_columns = null
                regenie_bsize_step1 = 1000
            }
            process {
                """
                input[0] = tuple(
                    1,  // chunk 1
                    file("$projectDir/tests/input/regenie/step1_split/chunks.master"),
                    file("$projectDir/tests/input/regenie/step1_split/chunks_job1.snplist"),
                    "example",
                    [
                        file("$projectDir/tests/input/regenie/step1_run_chunk/example.bed"),
                        file("$projectDir/tests/input/regenie/step1_run_chunk/example.bim"),
                        file("$projectDir/tests/input/regenie/step1_run_chunk/example.fam")
                    ],
                    file("$projectDir/tests/input/phenotypes/basic/phenotype_Y1.txt"),
                    file("$projectDir/tests/input/regenie/step1_run_chunk/covariates.txt"),
                    "Y1",
                    false
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert regenie_step1_out
                assert regenie_step1_out_log

                def logFile = path(regenie_step1_out_log.get(0))
                assert logFile.text.contains("--covarFile")
                assert logFile.text.contains("--covarColList")

                def chunkTuple = regenie_step1_out.get(0)
                def chunkFiles = chunkTuple.get(1)
                def outputFiles = chunkFiles instanceof java.util.List ? chunkFiles : [chunkFiles]
                assert outputFiles.size() > 0
            }
        }
    }
}
