nextflow_process {

    name "Test Process REGENIE_STEP2"
    script "modules/local/regenie/regenie_step2_run.nf"
    process "REGENIE_STEP2_RUN"

    test("Should execute regenie step2 without predictions") {

        when {
            params {
                //set required phenotypes_column
                regenie_test = 'additive'
                regenie_skip_predictions = false
                covariates_columns = 'V2,V3'
                covariates_cat_columns = 'V1'
            }
            process {
                """
                input[0] = tuple(
                    [
                        file("$projectDir/tests/input/regenie/step1_out/regenie_step1_out_pred.list"),
                        file("$projectDir/tests/input/regenie/step1_out/regenie_step1_out_1.loco.gz"),
                        file("$projectDir/tests/input/regenie/step1_out/regenie_step1_out_2.loco.gz")
                    ],
                    -1,
                    "chr01.vcf",
                    file("$projectDir/tests/input/regenie/step2/chr01.vcf.bed"),
                    file("$projectDir/tests/input/regenie/step2/chr01.vcf.bim"),
                    file("$projectDir/tests/input/regenie/step2/chr01.vcf.fam"),
                    -1,
                    "plink",
                    file("$projectDir/tests/input/phenotypes/basic/phenotype_Y1.txt"),
                    file("$projectDir/tests/input/regenie/step2/covariates.txt"),
                    "Y1",
                    false
                )
                """
            }
        }

        then {
            assert process.success
            //check amount of processes
            assert process.trace.tasks().size() == 1

            with(process.out) {
                with(regenie_step2_out.get(0)){
                    def resultFiles = get(1)
                    def firstResult = resultFiles instanceof java.util.List ? resultFiles.get(0) : resultFiles
                    def lines = path(firstResult).readLinesGzip()
                    assert lines.size() > 1
                    assert lines.get(0).contains("CHROM")
                    assert lines.get(0).contains("LOG10P")
                }

                with(regenie_step2_out_log){
                    def logText = path(get(0)).text
                    assert logText.contains("--step 2")
                    assert logText.contains("--phenoColList Y1")
                    assert logText.contains("--test additive")
                }

            }
        }

    }

}
