nextflow_process {

    name "Test Process REGENIE_STEP1"
    script "modules/local/regenie/regenie_step1_run.nf"
    process "REGENIE_STEP1_RUN"

    test("Should execute regenie step 1 for a single phenotype") {

        when {
            params {
                // set required phenotypes_column
                covariates_columns = 'V2,V3'
                covariates_cat_columns = 'V1'
            }
            process {
                """
                input[0] = tuple(
                    "example",
                    [
                        file("$projectDir/tests/input/regenie/step1/example.bed"),
                        file("$projectDir/tests/input/regenie/step1/example.bim"),
                        file("$projectDir/tests/input/regenie/step1/example.fam")
                    ],
                    file("$projectDir/tests/input/phenotypes/basic/phenotype_Y1.txt"),
                    file("$projectDir/tests/input/regenie/step1/covariates.txt"),
                    "Y1",
                    false
                )
                """
            }
        }

        then {
            assert process.success
           
            with(process.out) {
                assert regenie_step1_out
                def step1Tuple = regenie_step1_out.get(0)
                def step1Files = step1Tuple.get(1)
                assert step1Files instanceof java.util.List
                assert step1Files.size() > 0

                // Verify LOCO outputs are generated
                def locoFiles = step1Files.findAll { path(it).fileName.toString().endsWith('.loco.gz') }
                assert locoFiles.size() >= 1

                assert regenie_step1_out_log
                def logFile = path(regenie_step1_out_log.get(0))
                assert logFile.text.contains("--step 1")
                assert logFile.text.contains("--phenoColList Y1")
            }
        }

    }

}
