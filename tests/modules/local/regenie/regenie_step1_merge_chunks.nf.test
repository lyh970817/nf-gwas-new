nextflow_process {

    name "Test Process REGENIE_STEP1_MERGE_CHUNKS"
    script "modules/local/regenie/regenie_step1_merge_chunks.nf"
    process "REGENIE_STEP1_MERGE_CHUNKS"

    test("Should merge predictions from multiple chunks") {

        when {
            params {
                regenie_bsize_step1 = 1000
                covariates_columns = null
                covariates_cat_columns = null
            }
            process {
                """
                input[0] = tuple(
                    file("$projectDir/tests/input/regenie/step1_split/chunks.master"),
                    "example",
                    [
                        file("$projectDir/tests/input/regenie/step1_merge_chunks/example.bed"),
                        file("$projectDir/tests/input/regenie/step1_merge_chunks/example.bim"),
                        file("$projectDir/tests/input/regenie/step1_merge_chunks/example.fam")
                    ],
                    [
                        file("$projectDir/tests/input/regenie/step1_run_chunk/chunks_job1_l0_Y1")
                    ],
                    file("$projectDir/tests/input/phenotypes/basic/phenotype_Y1.txt"),
                    [],
                    "Y1",
                    false
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                // Check merged Step 1 outputs
                assert regenie_step1_out
                def step1Tuple = regenie_step1_out.get(0)
                def step1Files = step1Tuple.get(1)

                // Should contain LOCO files
                def step1Paths = step1Files instanceof java.util.List ? step1Files : [step1Files]
                assert step1Paths.size() > 0
                step1Paths.each { file ->
                    def stepPath = path(file)
                    assert stepPath.fileName.toString().matches("regenie_step1_out_.*\\.loco\\.gz")
                }

                assert regenie_step1_out_pred
                def predList = path(regenie_step1_out_pred.get(0).get(1))
                assert predList.fileName.toString() == "regenie_step1_out_pred.list"
                assert predList.text.contains("regenie_step1_out")
            }
        }
    }

    test("Should handle merge with covariates") {

        when {
            params {
                covariates_columns = 'V1,V2'
                covariates_cat_columns = null
                regenie_bsize_step1 = 1000
            }
            process {
                """
                input[0] = tuple(
                    file("$projectDir/tests/input/regenie/step1_split/chunks.master"),
                    "example",
                    [
                        file("$projectDir/tests/input/regenie/step1_merge_chunks/example.bed"),
                        file("$projectDir/tests/input/regenie/step1_merge_chunks/example.bim"),
                        file("$projectDir/tests/input/regenie/step1_merge_chunks/example.fam")
                    ],
                    [
                        file("$projectDir/tests/input/regenie/step1_run_chunk/chunks_job1_l0_Y1")
                    ],
                    file("$projectDir/tests/input/phenotypes/basic/phenotype_Y1.txt"),
                    file("$projectDir/tests/input/regenie/step1_merge_chunks/covariates.txt"),
                    "Y1",
                    false
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert regenie_step1_out

                assert regenie_step1_out_pred
                def predList = path(regenie_step1_out_pred.get(0).get(1))
                assert predList.text.contains("regenie_step1_out")

                assert regenie_step1_out_pred
            }
        }
    }
}
