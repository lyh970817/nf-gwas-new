nextflow_process {

    name "Test Process RUN_BOLT_REML"
    script "modules/local/bolt_lmm/run_reml.nf"
    process "RUN_BOLT_REML"

    test("Should execute BOLT-LMM REML analysis") {

        when {
            params {
                covariates_columns = null
                covariates_cat_columns = null
            }
            process {
                """
                input[0] = [
                    file("$projectDir/tests/input/bolt_lmm/chr01.vcf.bed"),
                    file("$projectDir/tests/input/bolt_lmm/chr02.vcf.bed")
                ]
                input[1] = [
                    file("$projectDir/tests/input/bolt_lmm/chr01.vcf.bim"),
                    file("$projectDir/tests/input/bolt_lmm/chr02.vcf.bim")
                ]
                input[2] = file("$projectDir/tests/input/bolt_lmm/chr01.vcf.fam")
                input[3] = tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt")
                )
                input[4] = []  // no covariates
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert log_file
                def logFile = path(log_file.get(0))

                assert logFile.fileName.toString().endsWith(".bolt.reml.log")
                assert logFile.size() > 0

                // Check log contains BOLT-LMM output
                def content = logFile.text
                assert content.contains("h²") || content.contains("heritability") || content.contains("Variance")
            }
        }
    }

    test("Should execute BOLT-LMM REML with covariates") {

        when {
            params {
                covariates_columns = 'V1,V2,V3'
                covariates_cat_columns = ''
            }
            process {
                """
                input[0] = [file("$projectDir/tests/input/bolt_lmm/chr01.vcf.bed")]
                input[1] = [file("$projectDir/tests/input/bolt_lmm/chr01.vcf.bim")]
                input[2] = file("$projectDir/tests/input/bolt_lmm/chr01.vcf.fam")
                input[3] = tuple(
                    "Y1",
                    file("$projectDir/tests/input/phenotypes/single/phenotype_single_Y1.txt")
                )
                input[4] = file("$projectDir/tests/input/bolt_lmm/covariates.txt")
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert log_file
                def logFile = path(log_file.get(0))

                assert logFile.size() > 0

                assert logFile.fileName.toString().endsWith(".bolt.reml.log")

                def content = logFile.text
                assert content.contains("h²") || content.contains("heritability") || content.contains("Variance")
            }
        }
    }
}
