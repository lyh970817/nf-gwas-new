nextflow_process {

    name "Test Process CALC_INFLATION"
    script "modules/local/ldak/calc_inflation.nf"
    process "CALC_INFLATION"

    test("Should calculate genomic inflation factor from REML results") {

        when {
            process {
                """
                input[0] = tuple(
                    "Y1",
                    file("$projectDir/tests/input/ldak/reml_results/reml_ldak_grm.reml"),
                    [
                        file("$projectDir/tests/input/ldak/reml_results/reml_chr01.vcf.reml"),
                        file("$projectDir/tests/input/ldak/reml_results/reml_chr02.vcf.reml")
                    ]
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert inflation_results
                def inflationFile = path(inflation_results.get(0).get(1))

                assert inflationFile.fileName.toString() == "inflation_Y1.txt"
                assert inflationFile.size() > 0

                // Check file contains inflation values
                def content = inflationFile.text
                assert content.contains("Inflation") || content.contains("inflation") || content.contains("Full") || content.contains("Quarter")
            }
        }
    }
}
