nextflow_process {

    name "Test Process THIN_PREDICTORS"
    script "modules/local/ldak/thin_predictors.nf"
    process "THIN_PREDICTORS"

    test("Should thin predictors based on LD") {

        when {
            process {
                """
                // THIN_PREDICTORS expects 1 input: a 6-tuple
                // (chr_num, filename, bed, bim, fam, range)
                input[0] = tuple(
                    1,
                    "example",
                    file("$projectDir/tests/input/ldak/thin_predictors/example.bed"),
                    file("$projectDir/tests/input/ldak/thin_predictors/example.bim"),
                    file("$projectDir/tests/input/ldak/thin_predictors/example.fam"),
                    null
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert thin_predictors
                def thinnedFile = path(thin_predictors.get(0))

                assert thinnedFile.fileName.toString().endsWith(".in")
                assert thinnedFile.size() > 0
            }
        }
    }
}
