nextflow_process {

    name "Test Process KVIK_STEP2"
    script "modules/local/ldak/kvik_step2.nf"
    process "KVIK_STEP2"

    // NOTE: KVIK_STEP2 requires Step 1 outputs (kvik.step1.*)
    // These tests require pre-computed Step 1 outputs to be available
    // For initial testing, run Step 1 first and copy outputs to tests/input/ldak/kvik/

    test("Should execute KVIK Step 2 per-chromosome association") {

        tag "requires_step1_outputs"

        when {
            process {
                """
                // Per-chromosome PLINK files for Step 2
                input[0] = tuple(
                    1,
                    "chr01.vcf",
                    file("\$projectDir/tests/input/ldak/kvik_step2/chr01.vcf.bed"),
                    file("\$projectDir/tests/input/ldak/kvik_step2/chr01.vcf.bim"),
                    file("\$projectDir/tests/input/ldak/kvik_step2/chr01.vcf.fam"),
                    file("\$projectDir/tests/input/ldak/kvik_step2/phenotype_single.txt"),
                    file("\$projectDir/tests/input/ldak/kvik/kvik.step1.root"),
                    file("\$projectDir/tests/input/ldak/kvik/kvik.step1.loco.details"),
                    file("\$projectDir/tests/input/ldak/kvik/kvik.step1.loco.prs"),
                    file("\$projectDir/tests/input/ldak/kvik/kvik.step1.effects"),
                    "Y1",
                    1,
                    []
                )
                input[1] = file("\$projectDir/tests/input/ldak/kvik_step2/covariates.txt")
                input[2] = []
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert step2_chr_results
                assert step2_assoc

                // Verify association file has content
                def assocTuple = step2_assoc.get(0)
                def assocFile = assocTuple.get(1)
                assert path(assocFile).size() > 0
            }
        }
    }
}
