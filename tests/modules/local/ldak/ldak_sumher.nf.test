nextflow_process {

    name "Test Process LDAK_SUMHER"
    script "modules/local/ldak/ldak_sumher.nf"
    process "LDAK_SUMHER"

    test("Should estimate heritability from summary statistics using thin tagging file") {

        when {
            params {
                ldak_sumher_check_sums = false
                ldak_sumher_prevalence = null
                ldak_sumher_ascertainment = null
                ldak_sumher_cutoff = null
            }
            process {
                """
                input[0] = Channel.of(["test_trait", file("${projectDir}/tests/input/ldak/sumher/test_gwas_summary.txt"), null, null])
                input[1] = file("${projectDir}/tests/input/ldak/sumher/test_thin.tagging")
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1

            // Check heritability results file exists
            with(process.out.heritability_results) {
                assert size() == 1
                assert path(get(0)).exists()

                def hersFile = path(get(0))
                def commandFile = hersFile.parent.resolve('.command.sh')
                assert commandFile.exists()
                def commandText = commandFile.text
                assert !commandText.contains('--prevalence')
                assert !commandText.contains('--ascertainment')
            }
        }
    }

    test("Should pass prevalence and ascertainment flags when provided") {

        when {
            params {
                ldak_sumher_check_sums = false
                ldak_sumher_prevalence = null
                ldak_sumher_ascertainment = null
                ldak_sumher_cutoff = null
            }
            process {
                """
                input[0] = Channel.of(["test_trait_bin", file("${projectDir}/tests/input/ldak/sumher/test_gwas_summary.txt"), "0.12", "0.47"])
                input[1] = file("${projectDir}/tests/input/ldak/sumher/test_thin.tagging")
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1

            with(process.out.heritability_results) {
                assert size() == 1
                def hersFile = path(get(0))
                assert hersFile.exists()

                def commandFile = hersFile.parent.resolve('.command.sh')
                assert commandFile.exists()
                def commandText = commandFile.text
                assert commandText.contains('--prevalence 0.12')
                assert commandText.contains('--ascertainment 0.47')
            }
        }
    }
}
