nextflow_process {

    name "Test Process KVIK_STEP1"
    script "modules/local/ldak/kvik_step1.nf"
    process "KVIK_STEP1"

    test("Should execute KVIK Step 1 with quantitative phenotype") {

        when {
            process {
                """
                // KVIK Step 1 requires merged genotype data with multiple chromosomes for LOCO PRS
                // merged_chr has chr1 and chr2 (2000 variants), which allows LOCO analysis
                input[0] = tuple(
                    "merged_chr",
                    file("\$projectDir/tests/input/merged_chr.bed"),
                    file("\$projectDir/tests/input/merged_chr.bim"),
                    file("\$projectDir/tests/input/merged_chr.fam")
                )
                input[1] = file("\$projectDir/tests/input/phenotype_single.txt")
                input[2] = file("\$projectDir/tests/input/covariates.txt")
                input[3] = "test_pheno"  // phenotype_name
                input[4] = false  // is_binary (quantitative trait)
                input[5] = 1  // mpheno (first phenotype column)
                input[6] = []  // no extract file
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                // Verify Step 1 outputs are generated
                assert step1_outputs
                assert step1_root
                assert step1_loco_details
                assert step1_loco_prs
                assert step1_effects
            }
        }
    }

    test("Should execute KVIK Step 1 without covariates") {

        when {
            process {
                """
                // Use merged_chr with multiple chromosomes for LOCO analysis
                input[0] = tuple(
                    "merged_chr",
                    file("\$projectDir/tests/input/merged_chr.bed"),
                    file("\$projectDir/tests/input/merged_chr.bim"),
                    file("\$projectDir/tests/input/merged_chr.fam")
                )
                input[1] = file("\$projectDir/tests/input/phenotype_single.txt")
                input[2] = []  // No covariates
                input[3] = "test_pheno_nocov"
                input[4] = false
                input[5] = 1
                input[6] = []
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert step1_outputs
                assert step1_root
            }
        }
    }
}
