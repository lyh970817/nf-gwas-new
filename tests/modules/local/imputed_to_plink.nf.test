nextflow_process {

    name "Test Process IMPUTED_TO_PLINK"
    script "modules/local/imputed_to_plink.nf"
    process "IMPUTED_TO_PLINK"

    test("Should create a bed, bim and fam file with 500 samples") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(1, file("$projectDir/tests/input/chr01.vcf.gz")),
                    tuple(2, file("$projectDir/tests/input/chr02.vcf.gz"))
                )
                """
            }
        }

        then {
            assert process.success
            with(process.out){
                assert imputed_plink
                assert imputed_plink.size() == 2
                with(imputed_plink.get(0)){
                    assert get(0) == 1
                    assert get(1) == "chr01.vcf"
                    assert get(2) ==~ ".*/chr01.vcf.bed"
                    assert get(3) ==~ ".*/chr01.vcf.bim"
                    assert get(4) ==~ ".*/chr01.vcf.fam"
                    assert file(get(4)).readLines().size() == 500
                }
                with(imputed_plink.get(1)){
                    assert get(0) == 2
                    assert get(1) == "chr02.vcf"
                    assert get(2) ==~ ".*/chr02.vcf.bed"
                    assert get(3) ==~ ".*/chr02.vcf.bim"
                    assert get(4) ==~ ".*/chr02.vcf.fam"
                    assert file(get(4)).readLines().size() == 500
                }
            }
        }
    }
}
