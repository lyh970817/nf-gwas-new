{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nf-gwas/master/nextflow_schema.json",
  "title": "nf-gwas pipeline parameters",
  "description": "A Nextflow GWAS pipeline.",
  "type": "object",
  "$defs": {
    "common_inputs": {
      "title": "Common Inputs",
      "type": "object",
      "description": "Shared input/output and metadata parameters used across workflows.",
      "properties": {
        "project": {
          "type": "string",
          "description": "Optional project name for external bookkeeping."
        },
        "pubDir": {
          "type": "string",
          "description": "Pipeline publish directory for results."
        },
        "genotyped_file": {
          "type": "string",
          "description": "Directly genotyped PLINK pattern (e.g. 'data/genotyped.{bed,bim,fam}')."
        },
        "genotypes_build": {
          "type": "string",
          "description": "Optional genotype build label (e.g. hg19/hg38)."
        },
        "imputed_genotyped_files_vcf": {
          "type": "string",
          "description": "Imputed VCF pattern (e.g. 'data/chr*.vcf.gz')."
        },
        "imputed_genotyped_files_plink1": {
          "type": "string",
          "description": "Imputed PLINK1 pattern (e.g. 'data/chr*.{bed,bim,fam}')."
        },
        "imputed_genotyped_files_plink2": {
          "type": "string",
          "description": "Imputed PLINK2 pattern (e.g. 'data/chr*.{pgen,psam,pvar}')."
        },
        "phenotypes_dir": {
          "type": "string",
          "format": "directory-path",
          "description": "Directory containing one phenotype file per trait."
        },
        "summary_stats_dir": {
          "type": "string",
          "format": "directory-path",
          "description": "Directory containing summary statistics; association outputs are linked here for downstream workflows."
        },
        "grm_dir": {
          "type": "string",
          "format": "directory-path",
          "description": "Directory containing reusable GRM symlinks; pipeline-generated GCTA/LDAK GRMs are linked into gcta_grm/ and ldak_grm/."
        },
        "covariates_filename": {
          "type": "string",
          "format": "file-path",
          "description": "Path to covariates file."
        },
        "covariates_columns": {
          "type": "string",
          "description": "Comma-separated quantitative covariate columns."
        },
        "covariates_cat_columns": {
          "type": "string",
          "description": "Comma-separated categorical covariate columns."
        },
        "max_cpus": {
          "type": "integer",
          "default": 10
        },
        "max_memory": {
          "type": "string",
          "default": "16.GB"
        }
      }
    },
    "workflow_toggles": {
      "title": "Workflow Toggles",
      "type": "object",
      "description": "Enable one or more workflows directly; methods are no longer mutually exclusive selectors.",
      "properties": {
        "run_assoc_regenie": { "type": "boolean", "default": true },
        "run_assoc_fastgwa": { "type": "boolean", "default": false },
        "run_assoc_kvik": { "type": "boolean", "default": false },

        "run_h2_gcta_grm": { "type": "boolean", "default": false },
        "run_h2_ldak_grm": { "type": "boolean", "default": false },
        "run_h2_gcta_greml": { "type": "boolean", "default": false },
        "run_h2_gcta_greml_ldms": { "type": "boolean", "default": false },
        "run_h2_bolt_lmm_reml": { "type": "boolean", "default": false },
        "run_h2_ldak_reml": { "type": "boolean", "default": false },
        "run_h2_ldak_he": { "type": "boolean", "default": false },
        "run_h2_ldak_pcgc": { "type": "boolean", "default": false },
        "run_h2_ldak_qc": { "type": "boolean", "default": false },
        "run_h2_ldak_sumher": { "type": "boolean", "default": false },
        "run_h2_ldsc_h2": { "type": "boolean", "default": false },

        "run_rg_ldak_sumcors": { "type": "boolean", "default": false },
        "run_rg_ldsc_rg": { "type": "boolean", "default": false },
        "run_rg_gcta_bivariate_greml": { "type": "boolean", "default": false },
        "run_rg_gcta_bivariate_greml_ldms": { "type": "boolean", "default": false },

        "run_magma_gene_based": { "type": "boolean", "default": false },
        "run_magma_gene_set": { "type": "boolean", "default": false },

        "run_lava_local_rg": { "type": "boolean", "default": false },
        "run_lcv_causal": { "type": "boolean", "default": false },

        "run_munge_sumstats": { "type": "boolean", "default": false }
      }
    },
    "association": {
      "title": "GWAS Association",
      "type": "object",
      "properties": {
        "regenie_skip_predictions": { "type": "boolean", "default": false },
        "phenotypes_apply_rint": { "type": "boolean", "default": false },
        "regenie_test": { "type": "string", "default": "additive" },
        "regenie_force_step1": { "type": "boolean", "default": false },
        "regenie_low_mem": { "type": "boolean", "default": false },
        "regenie_firth": { "type": "boolean", "default": false },
        "regenie_firth_approx": { "type": "boolean", "default": false },
        "regenie_bsize_step1": { "type": "integer", "default": 1000 },
        "regenie_bsize_step2": { "type": "integer", "default": 200 },
        "regenie_step1_optional": { "type": "string" },
        "regenie_step2_optional": { "type": "string" },
        "kvik_step1_optional": { "type": "string" },
        "kvik_step2_optional": { "type": "string" },
        "genotypes_prediction_chunks": { "type": "integer", "default": 0 }
      }
    },
    "sumstats_shared": {
      "title": "Shared Sumstats Columns",
      "type": "object",
      "description": "Shared summary-statistics column definitions reused by MAGMA and LDSC.",
      "properties": {
        "sumstats_snp_col": { "type": "string", "default": "Predictor" },
        "sumstats_a1_col": { "type": "string", "default": "A1" },
        "sumstats_a2_col": { "type": "string", "default": "A2" },
        "sumstats_p_col": { "type": "string", "default": "P" },
        "sumstats_log10p_col": { "type": "string" },
        "sumstats_n_col": { "type": "string", "default": "n" },
        "sumstats_n": { "type": "number" },
        "ldsc_munge_signed_sumstats": { "type": "string" }
      }
    },
    "heritability_individual": {
      "title": "Heritability (Individual Level)",
      "type": "object",
      "properties": {
        "heritability_model": { "type": "string", "default": "human_default" },
        "nparts_gcta": { "type": "integer", "default": 15 },
        "gcta_create_sparse_grm": { "type": "boolean", "default": false },
        "gcta_sparse_cutoff": { "type": "number", "default": 0.05 },
        "ldak_adjust_grm": { "type": "boolean", "default": false },

        "gcta_grm_prefix": { "type": "string", "default": "${projectDir}/grm/gcta_grm/gcta_grm_0_adj_unrel05" },
        "gcta_mgrm_file": { "type": "string", "format": "file-path", "default": "${projectDir}/grm/gcta_grm_ldms/gcta_grm_ldms.mgrm" },
        "gcta_sparse_grm_prefix": { "type": "string", "default": "${projectDir}/grm/gcta_grm_sparse/gcta_grm_0_adj_unrel05_sp" },
        "ldak_grm_prefix": { "type": "string", "default": "${projectDir}/grm/ldak_grm/ldak_grm" },
        "ldak_adjusted_grm_prefix": { "type": "string", "default": "${projectDir}/grm/ldak_grm_adjusted/ldak_grm_adj" },

        "ldak_he_subset_prefix": { "type": "string" },
        "ldak_he_subset_number": { "type": "integer" },
        "ldak_reml_prevalence": { "type": "number", "minimum": 0, "maximum": 1 },
        "ldak_pcgc_prevalence": { "type": "number", "minimum": 0, "maximum": 1 },
        "batch_subset_prefix": { "type": "string" },
        "batch_subset_number": { "type": "integer" }
      }
    },
    "heritability_sumstats": {
      "title": "Heritability (Sumstats)",
      "type": "object",
      "properties": {
        "ldak_sumher_tagfile": { "type": "string", "format": "file-path" },
        "ldak_sumher_check_sums": { "type": "boolean", "default": false },
        "ldak_sumher_prevalence": { "type": "number", "minimum": 0, "maximum": 1 },
        "ldak_sumher_prevalence_map": { "type": "string", "format": "file-path" },
        "ldak_sumher_ascertainment": { "type": "number", "minimum": 0, "maximum": 1 },
        "ldak_sumher_ascertainment_map": { "type": "string", "format": "file-path" },
        "ldak_sumher_cutoff": { "type": "number" },

        "ldak_sumstats_liftover": { "type": "boolean", "default": false },
        "ldak_sumstats_target_build": { "type": "string", "default": "GRCh37" },
        "ldak_sumstats_source_build": { "type": "string", "default": "auto" },
        "ldak_sumstats_frq_filter": { "type": "number", "default": 0.01 },

        "ldsc_ref_ld_chr": { "type": "string" },
        "ldsc_w_ld_chr": { "type": "string" },
        "ldsc_h2_extra_args": { "type": "string" },
        "ldsc_munge_extra_args": { "type": "string" }
      }
    },
    "genetic_correlation": {
      "title": "Genetic Correlation",
      "type": "object",
      "properties": {
        "ldak_sumcors_tagfile": { "type": "string", "format": "file-path" },
        "ldak_sumcors_check_sums": { "type": "boolean", "default": false },
        "ldak_sumcors_summary_stats1": { "type": "string", "format": "file-path" },
        "ldak_sumcors_summary_stats2": { "type": "string", "format": "file-path" },
        "ldsc_rg_extra_args": { "type": "string" },
        "gcta_bivariate_phenotype1": { "type": "string" },
        "gcta_bivariate_phenotype2": { "type": "string" }
      }
    },
    "magma": {
      "title": "Gene-Based Associations (MAGMA)",
      "type": "object",
      "properties": {
        "magma_reference_plink": { "type": "string" },
        "magma_gene_annot": { "type": "string", "format": "file-path" },
        "magma_gene_loc": { "type": "string", "format": "file-path" },
        "magma_set_annot": { "type": "string", "format": "file-path" },
        "magma_gene_results_dir": { "type": "string", "format": "directory-path" },

        "magma_gene_input_mode": {
          "type": "string",
          "default": "sumstats",
          "enum": ["sumstats", "raw"]
        },
        "magma_raw_extra_args": { "type": "string" },

        "magma_window_up_kb": { "type": "integer", "default": 35 },
        "magma_window_down_kb": { "type": "integer", "default": 10 },
        "magma_gene_model": { "type": "string" },
        "magma_gene_extra_args": { "type": "string" },
        "magma_set_model": { "type": "string" },
        "magma_set_extra_args": { "type": "string" }
      }
    },
    "other_workflows": {
      "title": "Other Workflows",
      "type": "object",
      "properties": {
        "lava_analysis_id": { "type": "string", "default": "lava_local_rg" },
        "lava_ref_plink": { "type": "string" },
        "lava_loci_file": { "type": "string", "format": "file-path" },
        "lava_sample_overlap_file": { "type": "string", "format": "file-path" },
        "lava_univ_threshold": { "type": "number", "default": 0.05 },

        "lcv_analysis_id": { "type": "string", "default": "lcv_causal" },
        "lcv_ldscores_file": { "type": "string", "format": "file-path" },
        "lcv_sumstats_trait1": { "type": "string", "format": "file-path" },
        "lcv_sumstats_trait2": { "type": "string", "format": "file-path" },
        "lcv_trait1_name": { "type": "string" },
        "lcv_trait2_name": { "type": "string" },
        "lcv_no_blocks": { "type": "integer", "default": 100 },
        "lcv_sig_threshold": { "type": "number", "default": 30 },
        "lcv_crosstrait_intercept": { "type": "number", "default": 1 },
        "lcv_ldsc_intercept": { "type": "number", "default": 1 }
      }
    },
    "utilities": {
      "title": "Utilities",
      "type": "object",
      "properties": {
        "munge_genome_build": { "type": "string", "default": "GRCh38" },
        "munge_dbsnp_version": { "type": "integer", "default": 0 }
      }
    }
  },
  "allOf": [
    { "$ref": "#/$defs/common_inputs" },
    { "$ref": "#/$defs/workflow_toggles" },
    { "$ref": "#/$defs/association" },
    { "$ref": "#/$defs/sumstats_shared" },
    { "$ref": "#/$defs/heritability_individual" },
    { "$ref": "#/$defs/heritability_sumstats" },
    { "$ref": "#/$defs/genetic_correlation" },
    { "$ref": "#/$defs/magma" },
    { "$ref": "#/$defs/other_workflows" },
    { "$ref": "#/$defs/utilities" }
  ]
}
