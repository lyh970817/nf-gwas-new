/*
========================================================================================
    Test profile for LDAK REML heritability estimation
========================================================================================
    Standard REML heritability estimation using LDAK kinships.
    More accurate than HE regression but slower.
*/

params {
    // Enable heritability estimation
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false

    // Use LDAK REML method
    heritability_method           = 'ldak_reml'
    heritability_model            = 'human'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
