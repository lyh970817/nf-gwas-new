/*
 * Test configuration for GCTA GREML with pre-computed GRM
 */

params {
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false
    heritability_method           = 'gcta_greml'

    // Pre-computed GRM mode
    use_precomputed_grm           = true
    gcta_grm_prefix               = "${baseDir}/results/gcta/gcta_grm_0_adj_unrel05"
}
