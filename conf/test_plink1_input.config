/*
========================================================================================
    Test configuration for PLINK1 input format (bed/bim/fam)
========================================================================================
    Tests pipeline with PLINK1 files as input (skipping VCF conversion).

    Use as follows:
        nextflow run main.nf -profile test,test_plink1_input,singularity
----------------------------------------------------------------------------------------
*/

params {
    // Override: use PLINK1 files instead of VCF
    imputed_genotyped_files_vcf      = null
    imputed_genotyped_files_plink1   = "$baseDir/tests/input/chr*.vcf.{bed,bim,fam}"
}
