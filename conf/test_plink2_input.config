/*
========================================================================================
    Test configuration for PLINK2 input format (pgen/psam/pvar)
========================================================================================
    Tests pipeline with PLINK2 files as input (skipping VCF conversion).

    Use as follows:
        nextflow run main.nf -profile test,test_plink2_input,singularity
----------------------------------------------------------------------------------------
*/

params {
    // Override: use PLINK2 files instead of VCF
    imputed_genotyped_files_vcf      = null
    imputed_genotyped_files_plink2   = "$baseDir/tests/input/chr*.vcf.{pgen,psam,pvar}"
}
