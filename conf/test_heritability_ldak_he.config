/*
========================================================================================
    Test profile for LDAK HE (Haseman-Elston regression) heritability estimation
========================================================================================
    Fast heritability estimation using HE regression instead of REML.
    10-100x faster than REML with slight accuracy trade-off.
*/

params {
    // Enable heritability estimation
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false

    // Use LDAK HE method
    heritability_method           = 'ldak_he'
    heritability_model            = 'human'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
