/*
========================================================================================
    Test profile for REGENIE association analysis
========================================================================================
*/

params {
    // Enable association analysis
    run_association_analysis      = true
    run_heritability_estimation   = false
    run_genetic_correlation       = false

    // Use REGENIE method
    association_method            = 'regenie'

    // Test with 2 phenotypes
    phenotypes_columns            = 'Y1,Y2'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
