/*
========================================================================================
    Test profile for LDAK QC workflow
========================================================================================
    Comprehensive QC workflow including genotype error estimation from batch subsets.
    Part of the LDAK heritability analysis pipeline.
*/

params {
    // Enable heritability estimation
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false

    // Use LDAK QC method
    heritability_method           = 'ldak_qc'
    heritability_model            = 'human'

    // LDAK batch subset parameters (for genotype error estimation)
    batch_subset_prefix           = "$baseDir/tests/input/test_batch"
    batch_subset_number           = 3
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
