/*
========================================================================================
    Comprehensive test profile - runs all major workflows
========================================================================================
    WARNING: This will run:
    1. REGENIE association analysis (Step 1 + Step 2)
    2. GCTA GREML heritability estimation
    3. LDAK QC heritability estimation with inflation testing

    This is resource-intensive and time-consuming. Use for comprehensive validation only.
    For faster testing, use individual workflow test profiles.
========================================================================================
*/

params {
    // Enable all workflow types
    run_association_analysis      = true
    run_heritability_estimation   = true
    run_genetic_correlation       = false  // Requires external summary stats files

    // Use REGENIE for association
    association_method            = 'regenie'

    // Use LDAK QC for heritability (fastest comprehensive test)
    heritability_method           = 'ldak_qc'

    // Test with 2 phenotypes for association
    phenotypes_columns            = 'Y1,Y2'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 3.GB
    }

    // Increase resources for key processes
    withName: 'REGENIE_STEP1_RUN|REGENIE_STEP2_RUN' {
        cpus = 4
        memory = 4.GB
    }

    withName: 'MAKE_GRM_PART|CALC_KINS_HUMAN' {
        cpus = 4
        memory = 4.GB
    }
}
