/*
========================================================================================
    LDAK GRM Test Configuration
========================================================================================
    Test profile for running LDAK kinship matrix computation only
    (with optional adjustment for HE/PCGC regression)
========================================================================================
*/

params {
    // Analysis mode
    run_grm_only                = true
    run_heritability_estimation = false
    run_association_analysis    = false
    run_genetic_correlation     = false

    // GRM method
    grm_method                  = 'ldak'
    heritability_model          = 'human_default'
    ldak_adjust_grm             = true    // Also create adjusted GRM for HE/PCGC
}
