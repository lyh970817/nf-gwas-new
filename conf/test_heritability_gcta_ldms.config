/*
========================================================================================
    Test profile for GCTA GREML LDMS heritability estimation
========================================================================================
    LD-stratified multi-component GREML using multiple GRMs by MAF/LD bins.
    More accurate than standard GREML but computationally more expensive.
*/

params {
    // Enable heritability estimation
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false

    // Use GCTA GREML LDMS method
    heritability_method           = 'gcta_greml_ldms'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
