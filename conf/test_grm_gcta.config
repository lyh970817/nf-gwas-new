/*
========================================================================================
    GCTA GRM-only Test Configuration
========================================================================================
    Test profile for running GCTA GRM computation only
    (standard GRM, optionally with sparse GRM for FastGWA)
========================================================================================
*/

params {
    // Workflow mode
    run_assoc_regenie                  = false
    run_assoc_fastgwa                  = false
    run_assoc_kvik                     = false

    run_h2_gcta_grm                    = true
    run_h2_ldak_grm                    = false
    run_h2_gcta_greml                  = false
    run_h2_gcta_greml_ldms             = false
    run_h2_bolt_lmm_reml               = false
    run_h2_ldak_reml                   = false
    run_h2_ldak_he                     = false
    run_h2_ldak_pcgc                   = false
    run_h2_ldak_qc                     = false
    run_h2_ldak_sumher                 = false
    run_h2_ldsc_h2                     = false

    run_rg_ldak_sumcors                = false
    run_rg_ldsc_rg                     = false
    run_rg_gcta_bivariate_greml        = false
    run_rg_gcta_bivariate_greml_ldms   = false

    run_magma_gene_based               = false
    run_magma_gene_set                 = false
    run_lava_local_rg                  = false
    run_lcv_causal                     = false

    gcta_create_sparse_grm      = true    // Also create sparse GRM
    gcta_sparse_cutoff          = 0.05

    // GCTA parameters
    nparts_gcta                 = 3       // Fewer parts for small test data
}
