/*
========================================================================================
    Test profile for BOLT-LMM REML heritability estimation
========================================================================================
*/

params {
    // Enable heritability estimation
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false

    // Use BOLT-LMM REML method
    heritability_method           = 'bolt_lmm_reml'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
