/*
========================================================================================
    Test profile for GCTA GREML heritability estimation
========================================================================================
*/

params {
    // Enable heritability estimation
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false

    // Use GCTA GREML method
    heritability_method           = 'gcta_greml'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
