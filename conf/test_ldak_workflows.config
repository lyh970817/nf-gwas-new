/*
========================================================================================
    Test config for LDAK Workflow Tests
========================================================================================
    Tests LDAK HE, PCGC, and QC workflows

    Use with nf-test:
        nf-test test tests/workflows/ldak/*.nf.test -c conf/test_ldak_workflows.config
----------------------------------------------------------------------------------------
*/

params {
    project                       = 'test-ldak-workflows'
    genotypes_prediction          = "$baseDir/tests/input/pipeline/example.{bim,bed,fam}"
    genotypes_build               = 'hg19'
    phenotypes_filename           = "$baseDir/tests/input/pipeline/phenotype.txt"
    phenotypes_columns            = 'Y1'
    covariates_filename           = "$baseDir/tests/input/pipeline/covariates.txt"
    covariates_columns            = null
    covariates_cat_columns        = null

    // LDAK parameters with safe defaults
    ldak_use_he_regression        = true
    ldak_run_pcgc                 = true
    ldak_heritability_model       = 'human_default'
    ldak_pcgc_prevalence          = 0.2

    // Optional LDAK parameters - set to empty/null to avoid issues
    ldak_he_subset_prefix         = null
    ldak_he_subset_number         = null
    batch_subset_prefix           = null
    batch_subset_number           = null

    // Output directory
    pubDir                        = "$baseDir/results/test-ldak-workflows"
}

process {
    container = 'nf-gwas.sif'

    withName: '.*' {
        cpus = 1
        memory = 2.GB
    }
}

singularity {
    enabled = true
    autoMounts = true
}
