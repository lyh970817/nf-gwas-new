/*
 * Test configuration for GCTA GREML-LDMS with pre-computed multi-GRM
 */

params {
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false
    heritability_method           = 'gcta_greml_ldms'

    // Pre-computed GRM mode
    use_precomputed_grm           = true
    gcta_mgrm_file                = "${baseDir}/results/gcta/gcta_grm.mgrm"
}
