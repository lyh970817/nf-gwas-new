process {

  // ===========================================================================
  // VCF CONVERSION
  // ===========================================================================
  withName: 'IMPUTED_TO_PLINK' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 16.GB as Long) as Long }
  }

  withName: 'IMPUTED_TO_PLINK2' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 16.GB as Long) as Long }
  }

  // ===========================================================================
  // LDAK PROCESSES
  // ===========================================================================
  withName: 'THIN_PREDICTORS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 16.GB as Long) as Long }
  }

  withName: 'CREATE_THIN_WEIGHTS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 5.GB as Long) as Long }
  }

  withName: 'CALC_KINS_HUMAN' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'CALC_KINS_UNIFORM' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'CALC_KINS_WEIGHTS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'CALC_KINS_META' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'FILTER_RELATEDNESS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'ADD_GRMS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'ADJUST_GRM_LDAK' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'MAKE_MGRM_LDAK' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'LDAK_HE' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'LDAK_REML' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'LDAK_PCGC' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'LDAK_SUMHER' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'LDAK_SUMCORS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'CALC_INFLATION' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 2.GB as Long) as Long }
  }

  withName: 'CALC_GENOTYPE_ERROR_T2' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 2.GB as Long) as Long }
  }

  // ===========================================================================
  // QC PROCESSES
  // ===========================================================================
  withName: 'QC_FILTER_GENOTYPED' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'PRUNE_GENOTYPED' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  // ===========================================================================
  // GCTA PROCESSES
  // ===========================================================================
  withName: 'GCTA_GRM' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'CREATE_MPFILES_PER_CHROM' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'MERGE_MPFILES' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'MAKE_GRM_PART' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'MERGE_GRM_PARTS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'MERGE_SNP_GROUPS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'CALCULATE_LD_SCORES' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'ADJUST_GRM' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'ADD_GRMS_GCTA' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'FILTER_GRM_WITH_KEEP' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'MAKE_MGRM' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'MAKE_MPFILES' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'MAKE_BK_SPARSE' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'RUN_REML' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'RUN_REML_LDMS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'RUN_BIVARIATE_REML' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'RUN_BIVARIATE_REML_LDMS' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'RUN_FASTGWA_MLM' {
    cpus = { Math.min(params.max_cpus, 10) }
    memory = { Math.min(params.max_memory as Long, 10.GB as Long) as Long }
  }

  withName: 'REMOVE_RELATED_SUBJECTS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 2.GB as Long) as Long }
  }

  withName: 'PREPARE_PHENOCOV' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 2.GB as Long) as Long }
  }

  withName: 'PREPARE_PHENOCOV_BIVARIATE' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 2.GB as Long) as Long }
  }

  // ===========================================================================
  // REGENIE PROCESSES
  // ===========================================================================
  withName: 'REGENIE_STEP1_RUN' {
    cpus = { Math.min(params.max_cpus, 8) }
    memory = { Math.min(params.max_memory as Long, 16.GB as Long) as Long }
  }

  withName: 'REGENIE_STEP1_SPLIT' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'REGENIE_STEP1_RUN_CHUNK' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 12.GB as Long) as Long }
  }

  withName: 'REGENIE_STEP1_MERGE_CHUNKS' {
    cpus = { Math.min(params.max_cpus, 8) }
    memory = { Math.min(params.max_memory as Long, 16.GB as Long) as Long }
  }

  withName: 'REGENIE_STEP2_RUN' {
    cpus = { Math.min(params.max_cpus, 8) }
    memory = { Math.min(params.max_memory as Long, 8.GB as Long) as Long }
  }

  withName: 'REGENIE_STEP2_RUN_GENE_TESTS' {
    cpus = { Math.min(params.max_cpus, 8) }
    memory = { Math.min(params.max_memory as Long, 8.GB as Long) as Long }
  }

  withName: 'REGENIE_LOG_PARSER_STEP1' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'REGENIE_LOG_PARSER_STEP2' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  // ===========================================================================
  // POST-PROCESSING AND REPORTING
  // ===========================================================================
  withName: 'DOWNLOAD_RSIDS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'ANNOTATE_RESULTS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'FILTER_RESULTS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'MERGE_RESULTS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'LIFTOVER_RESULTS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  withName: 'REPORT' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 8.GB as Long) as Long }
  }

  withName: 'REPORT_GENE_BASED_TESTS' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 4.GB as Long) as Long }
  }

  withName: 'REPORT_INDEX' {
    cpus = 1
    memory = { Math.min(params.max_memory as Long, 1.GB as Long) as Long }
  }

  // ===========================================================================
  // ERROR HANDLING
  // ===========================================================================
  errorStrategy = 'retry'
  maxRetries = 3
}
