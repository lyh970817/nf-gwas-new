/*
========================================================================================
    GCTA GRM-LDMS Test Configuration
========================================================================================
    Test profile for running GCTA GRM computation with LD stratification
    (multiple GRMs stratified by MAF/LD, suitable for GREML-LDMS)
========================================================================================
*/

params {
    // Analysis mode
    run_grm_only                = true
    run_heritability_estimation = false
    run_association_analysis    = false
    run_genetic_correlation     = false

    // GRM method
    grm_method                  = 'gcta_ldms'

    // GCTA parameters
    nparts_gcta                 = 3       // Fewer parts for small test data
}
