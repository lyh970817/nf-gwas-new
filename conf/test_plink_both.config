/*
========================================================================================
    Test configuration for both PLINK1 and PLINK2 input (no conversions)
========================================================================================
    Tests pipeline with both PLINK1 and PLINK2 files supplied directly.
    This configuration skips all format conversions.

    Use as follows:
        nextflow run main.nf -profile test,test_plink_both,singularity
----------------------------------------------------------------------------------------
*/

params {
    // Override: use both PLINK1 and PLINK2 files (no conversions needed)
    imputed_genotyped_files_vcf      = null
    imputed_genotyped_files_plink1   = "$baseDir/tests/input/chr*.vcf.{bed,bim,fam}"
    imputed_genotyped_files_plink2   = "$baseDir/tests/input/chr*.vcf.{pgen,psam,pvar}"
}
