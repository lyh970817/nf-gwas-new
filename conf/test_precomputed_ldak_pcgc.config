/*
 * Test configuration for LDAK PCGC with pre-computed GRM
 */

params {
    run_association_analysis      = false
    run_heritability_estimation   = true
    run_genetic_correlation       = false
    heritability_method           = 'ldak_pcgc'

    // Pre-computed GRM mode
    use_precomputed_grm           = true
    ldak_grm_prefix               = "${baseDir}/results/ldak/ldak_grm"
    ldak_pcgc_prevalence          = 0.05

    // Override to use binary phenotype for PCGC
    phenotypes_filename           = "${baseDir}/tests/input/phenotype_bin.txt"
}
