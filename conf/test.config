/*
========================================================================================
    Nextflow config file for running comprehensive pipeline tests
========================================================================================
    Defines input files and everything required to run a comprehensive pipeline test
    that exercises all major workflows.

    Use as follows:
        nextflow run main.nf -profile test,<docker/singularity>

    Or use specific test profiles:
        - test_association_regenie: Test REGENIE association analysis
        - test_association_fastgwa: Test GCTA FastGWA association analysis
        - test_heritability_gcta: Test GCTA GREML heritability estimation
        - test_heritability_ldak: Test all LDAK heritability methods
        - test_heritability_bolt: Test BOLT-LMM heritability estimation
        - test_all: Run all workflows (comprehensive test)
----------------------------------------------------------------------------------------
*/

params {
    // =============================================================================
    // COMMON PARAMETERS (all workflows)
    // =============================================================================
    project                       = 'test-gwas'
    genotyped_file                = "$baseDir/tests/input/example.{bim,bed,fam}"
    imputed_genotyped_files_vcf   = "$baseDir/tests/input/chr*.vcf.gz"
    genotypes_build               = 'hg19'
    phenotypes_dir               = "$baseDir/tests/input/phenotypes/single"
    summary_stats_dir             = "$baseDir/tests/input/magma/sumstats"
    covariates_filename           = "$baseDir/tests/input/covariates.txt"
    covariates_columns            = 'V2,V3'
    covariates_cat_columns        = 'V1'

    // =============================================================================
    // WORKFLOW CONTROL (default: LDAK QC only)
    // =============================================================================
    // Override these in specific profiles to test different workflows
    run_assoc_regenie             = false
    run_assoc_fastgwa             = false
    run_assoc_kvik                = false
    run_h2_gcta_grm               = false
    run_h2_ldak_grm               = false
    run_h2_gcta_greml             = false
    run_h2_gcta_greml_ldms        = false
    run_h2_bolt_lmm_reml          = false
    run_h2_ldak_reml              = false
    run_h2_ldak_he                = false
    run_h2_ldak_pcgc              = false
    run_h2_ldak_qc                = false
    run_h2_ldak_sumher            = false
    run_h2_ldsc_h2                = false
    run_rg_ldak_sumcors           = false
    run_rg_ldsc_rg                = false
    run_rg_gcta_bivariate_greml   = false
    run_rg_gcta_bivariate_greml_ldms = false
    run_magma_gene_based          = false
    run_magma_gene_set            = false
    run_lava_local_rg             = false
    run_lcv_causal                = false

    // =============================================================================
    // ASSOCIATION ANALYSIS PARAMETERS
    // =============================================================================
    // REGENIE-specific parameters
    regenie_test                  = 'additive'
    regenie_skip_predictions      = false
    regenie_bsize_step1           = 100
    regenie_bsize_step2           = 200

    // =============================================================================
    // HERITABILITY ESTIMATION PARAMETERS
    // =============================================================================
    heritability_model            = 'human'  // LDAK kinship model

    // GCTA-specific parameters
    nparts_gcta                   = 3  // Number of GRM calculation chunks

    // LDAK batch subset parameters (for genotype error estimation in ldak_qc)
    batch_subset_prefix           = "$baseDir/tests/input/test_batch"
    batch_subset_number           = 3

    // LDAK PCGC parameters (required for binary traits)
    ldak_pcgc_prevalence          = null  // Set to e.g., 0.05 for binary traits

    // LDAK REML binary-trait prevalence (optional)
    ldak_reml_prevalence          = null  // Set to e.g., 0.05 when using ldak_reml on binary traits

    // LDAK SumHer test parameters (summary statistics-based heritability)
    // NOTE: These require external LDAK tagging files - disabled by default
    // ldak_sumher_tagfile           = "$baseDir/tests/input/ldak/bld.ldak.hapmap.gbr.tagging"
    // ldak_sumher_summary_stats     = "$baseDir/tests/input/ldak/height.txt"

    // =============================================================================
    // GENETIC CORRELATION PARAMETERS
    // =============================================================================
    ldsc_ref_ld_chr               = "$baseDir/tests/input/ldsc/smoke_reference/weights.synthetic."
    ldsc_w_ld_chr                 = "$baseDir/tests/input/ldsc/smoke_reference/weights.synthetic."
    sumstats_snp_col              = 'Predictor'
    sumstats_a1_col               = 'A1'
    sumstats_a2_col               = 'A2'
    sumstats_p_col                = 'P'
    sumstats_n_col                = 'n'
}

process {
    // Disable container for testing to avoid NixOS bash path issues
    // container = "${projectDir}/nf-gwas.sif"

    withName: '.*' {
        cpus = 1
        memory = 1.GB
    }
}

// Singularity configuration - disable for testing to avoid container issues
// singularity {
//     enabled = true
//     autoMounts = true
//     cacheDir = "$baseDir"
// }
