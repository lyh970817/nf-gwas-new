/*
========================================================================================
    Test config for LDAK Haseman-Elston (HE) Regression
========================================================================================
    Tests HE regression for fast heritability estimation on quantitative traits
    Use as follows:
        nextflow run workflows/ldak/ldak_he.nf -c conf/test_ldak_he.config -profile singularity
----------------------------------------------------------------------------------------
*/

params {
    project                       = 'test-ldak-he'
    genotypes_prediction          = "$baseDir/tests/input/pipeline/example.{bim,bed,fam}"
    genotypes_build               = 'hg19'
    phenotypes_filename           = "$baseDir/tests/input/pipeline/phenotype.txt"
    phenotypes_columns            = 'Y1'
    covariates_filename           = "$baseDir/tests/input/pipeline/covariates.txt"
    covariates_columns            = null
    covariates_cat_columns        = null

    // HE regression parameters
    ldak_use_he_regression        = true
    ldak_heritability_model       = 'human_default'

    // Optional: subset parameters for genotype error estimation
    ldak_he_subset_prefix         = "$baseDir/tests/input/pipeline/test_batch"
    ldak_he_subset_number         = 3

    // Output directory
    pubDir                        = "$baseDir/results/test-ldak-he"
}

process {
    container = 'nf-gwas.sif'

    withName: '.*' {
        cpus = 1
        memory = 2.GB
    }
}

singularity {
    enabled = true
    autoMounts = true
}
