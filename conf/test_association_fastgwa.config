/*
========================================================================================
    Test profile for GCTA FastGWA association analysis
========================================================================================
*/

params {
    // Enable association analysis
    run_association_analysis      = true
    run_heritability_estimation   = false
    run_genetic_correlation       = false

    // Use FastGWA method
    association_method            = 'fastgwa'
}

process {
    withName: '.*' {
        cpus = 2
        memory = 2.GB
    }
}
